# Apolosign WF2489T (RK3576: 4x Cortex-A72 + 4x Cortex-A53)
# U-Boot + kernel + minimal Linux
BR2_aarch64=y
BR2_cortex_a72_a53=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_1=y
BR2_REPRODUCIBLE=y
BR2_TARGET_GENERIC_HOSTNAME="wf2489t"
BR2_TARGET_GENERIC_ISSUE="Apolosign WF2489T"
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_WF2489T_PATH)/patches"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_WF2489T_PATH)/board/wf2489t/post-image.sh"
# Step 2: Rockchip U-Boot (next-dev) + boot safety net, FIT with rkbin BL31 v1.25 + OP-TEE v1.12
BR2_PACKAGE_WF2489T_RKBIN=y
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://github.com/rockchip-linux/u-boot.git"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="1c535d65b8509f388d09e49fb6961f49fda35a1d"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="rk3576"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_WF2489T_PATH)/board/wf2489t/uboot.fragment"
# Rockchip patched scripts/dtc (phandles from 0x10000000, needed to coexist with the kernel DTB) is used, not host-dtc
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="KCFLAGS=-Wno-error"
BR2_TARGET_UBOOT_NEEDS_PYTHON3=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
# BR2_TARGET_UBOOT_FORMAT_BIN is not set
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-nodtb.bin u-boot.dtb"
# Step 3: Rockchip kernel develop-6.1 + WF2489T device tree + AIC8800 Wi-Fi driver
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,rockchip-linux,kernel,77168c8d5ab82399f65a80e9f807b50ba37cf483)/linux-77168c8d5ab82399f65a80e9f807b50ba37cf483.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="rockchip_linux"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_WF2489T_PATH)/board/wf2489t/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_WF2489T_PATH)/board/wf2489t/dts"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_WF2489T_AIC8800=y
# Baseline system: BusyBox init, SSH (root password login), Ethernet (DHCP), login prompt on the screen
BR2_TARGET_GENERIC_ROOT_PASSWD="admin"
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_WF2489T_PATH)/board/wf2489t/rootfs-overlay"
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
