config BR2_PACKAGE_WF2489T_AIC8800
	bool "wf2489t-aic8800"
	depends on BR2_LINUX_KERNEL
	help
	  Driver and firmware for the AIC8800D80 Wi-Fi chip (SDIO),
	  from Radxa's maintained package, with its Debian patches.

	  https://github.com/radxa-pkg/aic8800

comment "wf2489t-aic8800 needs a Linux kernel to be built"
	depends on !BR2_LINUX_KERNEL
