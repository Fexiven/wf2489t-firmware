#!/bin/sh
# Wi-Fi (AIC8800D80): load the driver and, if /etc/wpa_supplicant.conf lists a
# network, connect and get an address by DHCP.

CONF=/etc/wpa_supplicant.conf

start() {
	modprobe aic8800_fdrv || return 1
	for i in $(seq 20); do
		[ -d /sys/class/net/wlan0 ] && break
		sleep 0.5
	done
	[ -d /sys/class/net/wlan0 ] || { echo "wifi: no wlan0"; return 1; }
	grep -q '^network=' "$CONF" 2>/dev/null || { echo "wifi: no network in $CONF"; return 0; }
	wpa_supplicant -B -i wlan0 -D nl80211 -c "$CONF" -P /var/run/wpa_supplicant.pid
	udhcpc -b -S -i wlan0 -p /var/run/udhcpc.wlan0.pid
}

stop() {
	[ -f /var/run/udhcpc.wlan0.pid ] && kill "$(cat /var/run/udhcpc.wlan0.pid)"
	[ -f /var/run/wpa_supplicant.pid ] && kill "$(cat /var/run/wpa_supplicant.pid)"
	return 0
}

case "$1" in
	start) printf "Starting Wi-Fi: "; start && echo OK || echo FAIL ;;
	stop) printf "Stopping Wi-Fi: "; stop && echo OK || echo FAIL ;;
	restart) stop; start ;;
	*) echo "usage: $0 {start|stop|restart}"; exit 1 ;;
esac
