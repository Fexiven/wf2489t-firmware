# WF2489T additions to Rockchip's rockchip_linux_defconfig

# GPU: open-source Panfrost (Mesa) instead of Rockchip's Mali kbase
# CONFIG_MALI_MIDGARD is not set
# CONFIG_MALI_BIFROST is not set
# CONFIG_MALI400 is not set
CONFIG_DRM_PANFROST=y

# boot safety net: keep petting the watchdog U-Boot armed
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y

# LED ring
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_PWM_MULTICOLOR=y
CONFIG_LEDS_GPIO=y

# sensors (upstream drivers instead of the vendor ones)
CONFIG_SENSORS_SHT3x=y
CONFIG_STK3310=y
CONFIG_KXCJK1013=y
CONFIG_TOUCHSCREEN_GOODIX=y

# Ethernet: RTL8168 with the upstream r8169 driver
CONFIG_R8169=y
# CONFIG_R8168 is not set

# audio: ES8388 codec, ES7202 PDM ADC as on the stock firmware
CONFIG_SND_SOC_ES8328_I2C=y
CONFIG_SND_SOC_ES7202_MIC_MAX_CHANNELS=2
CONFIG_SND_SOC_ES7202_I2C_BUS=1

# Wi-Fi: the out-of-tree AIC8800 driver needs cfg80211
CONFIG_CFG80211=y

# read-only SquashFS root with writable overlays
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y

# USB gadget Ethernet, for development access
CONFIG_USB_CONFIGFS_NCM=y

# not on this board: TV/radio tuners and Rockchip's Broadcom Wi-Fi driver
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_WL_ROCKCHIP is not set
