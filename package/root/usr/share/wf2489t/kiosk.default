# Kiosk (kiosk.service: labwc + TouchKio + on-screen keyboard)
KIOSK_URL=http://homeassistant.local:8123
# MQTT broker for the Home Assistant integration (optional), e.g.
# mqtt://broker.local:1883; keep this file readable by root only (chmod 600)
KIOSK_MQTT_URL=
KIOSK_MQTT_USER=
KIOSK_MQTT_PASSWORD=
# display brightness from the ambient light sensor (yes or no)
KIOSK_AUTO_BRIGHTNESS=yes
# person sensor from the front camera (on the NPU) in Home Assistant (yes or no);
# person score, box height as a fraction of the image for "near", seconds
# "in room" after the last person, seconds without a person until the display
# turns off (0 = never), display on with a person in the room or only near
# (person or near)
KIOSK_PERSON=yes
KIOSK_PERSON_THRESHOLD=0.5
KIOSK_PERSON_NEAR=0.40
KIOSK_PERSON_HOLD=120
KIOSK_PERSON_SCREEN_OFF=300
KIOSK_PERSON_WAKE=person
