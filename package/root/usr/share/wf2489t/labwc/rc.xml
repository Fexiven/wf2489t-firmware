<?xml version="1.0"?>
<!-- Kiosk: no window decorations. TouchKio switches between fullscreen and
     maximized itself (maximized while the on-screen keyboard is shown). -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>
  <windowRules>
    <!-- labwc takes over the decorations (so the client draws none) and then
         draws none -->
    <windowRule identifier="*">
      <action name="SetDecorations" decorations="none" forceSSD="yes"/>
    </windowRule>
  </windowRules>
  <keyboard>
    <default/>
  </keyboard>
</labwc_config>
