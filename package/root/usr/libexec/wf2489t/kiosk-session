#!/bin/sh
# Started by labwc: the on-screen keyboard (pops up in text fields) and
# TouchKio, restarted if it exits. Settings in /etc/default/kiosk.
gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled true
gsettings set org.gnome.desktop.interface color-scheme prefer-dark
gsettings set org.gnome.desktop.input-sources sources "[('xkb', 'de')]"
GTK_THEME=Adwaita:dark squeekboard &

# With KIOSK_MQTT_URL set, the tablet appears in Home Assistant (MQTT discovery)
set --
[ -n "$KIOSK_MQTT_URL" ] && set -- --mqtt-url="$KIOSK_MQTT_URL" \
	--mqtt-user="$KIOSK_MQTT_USER" --mqtt-password="$KIOSK_MQTT_PASSWORD"

# Fullscreen, maximized while the keyboard is shown (text-input-v3).
# DISPLAY is only checked by TouchKio, it runs on Wayland.
while :; do
	DISPLAY=:0 ELECTRON_OZONE_PLATFORM_HINT=wayland /usr/bin/touchkio \
		--web-url="$KIOSK_URL" --web-theme=dark --web-zoom=1.0 \
		--app-kiosk=fullscreen --enable-wayland-ime \
		--wayland-text-input-version=3 \
		--app-disable=mqtt_processor_temperature "$@"
	sleep 3
done
