#!/usr/bin/python3
# Motion sensor from the front camera (GC5035) for Home Assistant, attached to
# TouchKio's device (MQTT discovery). Streams raw frames at ~3.7 fps, averages
# the green pixels of each frame into a coarse grid of cells and compares it
# with a slowly adapting background; enough changed cells = motion. Simple
# auto exposure keeps the image at a fixed brightness. No model, no numpy.
# Optionally switches TouchKio's display off after a time without motion and
# on again with the next motion (KIOSK_MOTION_SCREEN_OFF, seconds).
# Settings from /etc/default/kiosk (KIOSK_MQTT_*, KIOSK_MOTION_*).
import glob
import os
import subprocess
import sys
import time

W, H = 1296, 972                    # raw SRGGB10, 16 bit per pixel, black level 64
FRAME = W * H * 2
STEP = 8                            # sample every 8th row and column (green pixels)
CELL = 6                            # samples per cell side -> 48x48 pixel cells
COLS, ROWS = W // STEP // CELL, H // STEP // CELL
TARGET = 0.3                        # auto exposure: mean brightness of the full scale
THRESHOLD = float(os.environ.get("KIOSK_MOTION_THRESHOLD") or 0.15)   # relative change per cell
CELLS = int(os.environ.get("KIOSK_MOTION_CELLS") or 5)                # changed cells for motion
HOLD = float(os.environ.get("KIOSK_MOTION_HOLD") or 30)              # seconds "on" after motion
SCREEN_OFF = float(os.environ.get("KIOSK_MOTION_SCREEN_OFF") or 300)  # display off after (0 = never)


def sh(*args):
    return subprocess.run(args, check=True, capture_output=True, text=True).stdout


def find_subdev(prefix):
    for name in glob.glob("/sys/class/video4linux/v4l-subdev*/name"):
        if open(name).read().startswith(prefix):
            return "/dev/" + name.split("/")[-2]
    sys.exit(f"no {prefix} sensor")


class Sensor:
    def __init__(self):
        self.dev = find_subdev("gc5035")
        fmt = f"SRGGB10_1X10/{W}x{H} field:none"
        for pad in ('"gc5035 4-0037":0', '"dw-mipi-csi2rx 27c80000.csi":0',
                    '"dw-mipi-csi2rx 27c80000.csi":1', '"rkcif-mipi0":0', '"rkcif-mipi0":1'):
            sh("media-ctl", "-d", "/dev/media0", "-V", f"{pad} [fmt:{fmt}]")
        sh("v4l2-ctl", "-d", "/dev/video0", f"--set-fmt-video=width={W},height={H},pixelformat=RG10")
        self.set(vertical_blanking=self.range("vertical_blanking")[1])    # lowest frame rate
        self.emin, self.emax = self.range("exposure")
        self.gmax = self.range("analogue_gain")[1]
        self.exposure, self.gain = self.emax // 2, 0
        self.set(exposure=self.exposure, analogue_gain=self.gain)

    def range(self, ctl):
        for line in sh("v4l2-ctl", "-d", self.dev, "-l").splitlines():
            f = line.split()
            if f and f[0] == ctl:
                kv = dict(p.split("=") for p in f if p.count("=") == 1)
                return int(kv["min"]), int(kv["max"])
        raise KeyError(ctl)

    def set(self, **ctls):
        sh("v4l2-ctl", "-d", self.dev, *[a for k, v in ctls.items() for a in ("-c", f"{k}={v}")])

    def adjust(self, mean):
        """Exposure first, then gain; returns True when something changed."""
        err = TARGET / max(mean, 0.005)
        if 0.7 < err < 1.4:
            return False
        total = self.exposure * (1 + self.gain / 8) * min(max(err, 0.5), 2.0)
        exp = int(min(max(total, self.emin), self.emax)) // 4 * 4
        gain = int(min(max((total / max(exp, 1) - 1) * 8, 0), self.gmax))
        if (exp, gain) == (self.exposure, self.gain):
            return False
        self.exposure, self.gain = exp, gain
        self.set(exposure=exp, analogue_gain=gain)
        return True


def cells(frame):
    """Mean of the green samples per cell (0..1), and the frame mean."""
    px = memoryview(frame).cast("H")
    sums = [0] * (COLS * ROWS)
    for r in range(ROWS * CELL):
        row = px[r * STEP * W + 1:(r * STEP + 1) * W:STEP]           # green: even row, odd column
        base = r // CELL * COLS
        for c in range(COLS):
            sums[base + c] += sum(row[c * CELL:(c + 1) * CELL])
    n = CELL * CELL * 959.0
    out = [max(s / n - 64 / 959.0, 0.0) for s in sums]
    return out, sum(out) / len(out)


class Mqtt:
    def __init__(self):
        url = os.environ.get("KIOSK_MQTT_URL", "")
        self.args = None
        if not url:
            return
        hostport = url.split("://", 1)[-1]
        host, _, port = hostport.partition(":")
        args = ["-h", host, "-p", port or "1883"]
        if os.environ.get("KIOSK_MQTT_USER"):
            args += ["-u", os.environ["KIOSK_MQTT_USER"], "-P", os.environ.get("KIOSK_MQTT_PASSWORD", "")]
        # same device id as TouchKio: last 6 characters of the serial number
        serial = open("/sys/firmware/devicetree/base/serial-number").read().strip("\0")
        self.id = "rpi_" + "".join(ch for ch in serial[-6:].upper() if ch.isalnum())
        self.topic = f"touchkio/{self.id}/motion/state"
        self.args = args
        self.pub(f"homeassistant/binary_sensor/{self.id}/motion/config",
                 f'{{"name":"Motion","unique_id":"{self.id}_motion","object_id":"{self.id}_motion",'
                 f'"device_class":"motion","state_topic":"{self.topic}",'
                 f'"device":{{"identifiers":["{self.id}"]}}}}')

    def pub(self, topic, msg):
        if self.args:
            subprocess.run(["mosquitto_pub", *self.args, "-r", "-t", topic, "-m", msg], check=False)

    def state(self, on):
        if self.args:
            self.pub(self.topic, "ON" if on else "OFF")

    def display(self, on):
        """TouchKio's display light (wlopm), so that Home Assistant sees the change too."""
        if self.args:
            subprocess.run(["mosquitto_pub", *self.args, "-t", f"touchkio/{self.id}/display/power/set",
                            "-m", "ON" if on else "OFF"], check=False)


def main():
    if os.environ.get("KIOSK_MOTION", "yes") != "yes":
        return
    mqtt = Mqtt()
    cam = Sensor()
    stream = subprocess.Popen(["v4l2-ctl", "-d", "/dev/video0", "--stream-mmap", "--stream-count=0",
                               "--stream-to=-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    frame, bg, settle = bytearray(FRAME), None, 2
    motion, last, screen_off = False, time.monotonic(), False
    mqtt.state(False)
    while True:
        if stream.stdout.readinto(frame) != FRAME:     # buffered: reads one whole frame
            sys.exit("camera stream ended")
        cur, mean = cells(frame)
        if cam.adjust(mean):
            settle = 2                                 # the next frame still has the old exposure
        if settle:
            settle -= 1
            bg = None
            continue
        if bg is None:
            bg = [a / max(mean, 0.005) for a in cur]
            continue
        # cells relative to the frame mean, so that light switched on or off does not count;
        # cells darker than 0.3 of the mean need the change of a cell at 0.3
        cur = [a / max(mean, 0.005) for a in cur]
        changed = sum(abs(a - b) > THRESHOLD * max(b, 0.3) for a, b in zip(cur, bg))
        bg = [b * 0.9 + a * 0.1 for a, b in zip(cur, bg)]
        now = time.monotonic()
        if os.environ.get("KIOSK_MOTION_DEBUG"):
            print(f"mean {mean:.3f} exp {cam.exposure} gain {cam.gain} changed {changed}", flush=True)
        if changed >= CELLS:
            last = now
            if not motion:
                motion = True
                mqtt.state(True)
            if screen_off:                             # only undo our own switch-off
                screen_off = False
                mqtt.display(True)
                settle = 10                            # the display lights the room: new background
        elif motion and now - last > HOLD:
            motion = False
            mqtt.state(False)
        if SCREEN_OFF and not screen_off and now - last > SCREEN_OFF:
            screen_off = True
            mqtt.display(False)
            settle = 10


if __name__ == "__main__":
    main()
