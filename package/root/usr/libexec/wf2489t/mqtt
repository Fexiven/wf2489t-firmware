#!/bin/sh
# Home Assistant entities for what TouchKio does not cover, attached to
# TouchKio's device (MQTT discovery): the RGB LED ring as a light (template
# schema), the ambient light sensor (STK3311; TouchKio only reads an IIO
# device named "als") and the processor temperature. Broker settings from
# /etc/default/kiosk (KIOSK_MQTT_URL, KIOSK_MQTT_USER, KIOSK_MQTT_PASSWORD).
set -u
. /etc/default/kiosk
[ -n "${KIOSK_MQTT_URL:-}" ] || { echo "no KIOSK_MQTT_URL, nothing to do"; exec sleep infinity; }

hostport=${KIOSK_MQTT_URL#*://}
host=${hostport%%:*}; port=${hostport##*:}; [ "$port" = "$hostport" ] && port=1883
set -- -h "$host" -p "$port"
[ -n "${KIOSK_MQTT_USER:-}" ] && set -- "$@" -u "$KIOSK_MQTT_USER" -P "${KIOSK_MQTT_PASSWORD:-}"

# same device id as TouchKio: last 6 characters of the serial number
serial=$(tr -d '\0' < /sys/firmware/devicetree/base/serial-number)
id=rpi_$(printf %s "$serial" | tail -c 6 | tr a-z A-Z | tr -cd A-Z0-9)
base=touchkio/$id/led_ring
led=/sys/class/leds/rgb:status
store=/var/lib/wf2489t-led/state            # on|off,brightness,red,green,blue
mkdir -p "${store%/*}"
[ -s "$store" ] || echo "off,255,255,255,255" > "$store"

apply() {  # set the LEDs from $store and report the state
	IFS=, read -r s b r g bl < "$store"
	echo "$r $g $bl" > "$led/multi_intensity"
	if [ "$s" = on ]; then echo "$b" > "$led/brightness"; else echo 0 > "$led/brightness"; fi
	mosquitto_pub "$@" -r -t "$base/state" -f "$store"
}

mosquitto_pub "$@" -r -t "homeassistant/light/$id/led_ring/config" -m "$(cat <<EOF
{"name":"LED Ring","unique_id":"${id}_led_ring","object_id":"${id}_led_ring",
 "schema":"template","icon":"mdi:led-strip-variant",
 "command_topic":"$base/set","state_topic":"$base/state",
 "command_on_template":"on,{{ brightness|d }},{{ red|d }},{{ green|d }},{{ blue|d }}",
 "command_off_template":"off",
 "state_template":"{{ value.split(',')[0] }}",
 "brightness_template":"{{ value.split(',')[1]|int }}",
 "red_template":"{{ value.split(',')[2]|int }}",
 "green_template":"{{ value.split(',')[3]|int }}",
 "blue_template":"{{ value.split(',')[4]|int }}",
 "device":{"identifiers":["$id"]}}
EOF
)"
apply "$@"

# ambient light sensor: lux = raw * scale, published when it changes
als=$(grep -l -x stk3310 /sys/bus/iio/devices/*/name 2>/dev/null | head -1)
if [ -n "$als" ]; then
	als=${als%/name}
	cfg='{"name":"Ambient Light","unique_id":"ID_ambient_light","object_id":"ID_ambient_light",'
	cfg=$cfg'"device_class":"illuminance","unit_of_measurement":"lx","state_class":"measurement",'
	cfg=$cfg'"state_topic":"touchkio/ID/ambient_light/state","device":{"identifiers":["ID"]}}'
	mosquitto_pub "$@" -r -t "homeassistant/sensor/$id/ambient_light/config" \
		-m "$(printf %s "$cfg" | sed "s/ID/$id/g")"
	(last=
	while :; do
		lux=$(awk -v r="$(cat "$als/in_illuminance_raw")" -v s="$(cat "$als/in_illuminance_scale")" \
			'BEGIN { printf "%.1f", r * s }')
		if [ "$lux" != "$last" ]; then
			mosquitto_pub "$@" -r -t "touchkio/$id/ambient_light/state" -m "$lux" && last=$lux
		fi
		sleep 10
	done) &
fi

# processor temperature (TouchKio only knows other thermal zone names, its own
# sensor is disabled in kiosk-session): package-thermal, published on change
tz=$(grep -l -x package-thermal /sys/class/thermal/thermal_zone*/type 2>/dev/null | head -1)
if [ -n "$tz" ]; then
	tz=${tz%/type}
	cfg='{"name":"Processor Temperature","unique_id":"ID_soc_temperature","object_id":"ID_processor_temperature",'
	cfg=$cfg'"device_class":"temperature","unit_of_measurement":"°C","state_class":"measurement",'
	cfg=$cfg'"icon":"mdi:radiator","state_topic":"touchkio/ID/soc_temperature/state","device":{"identifiers":["ID"]}}'
	mosquitto_pub "$@" -r -t "homeassistant/sensor/$id/soc_temperature/config" \
		-m "$(printf %s "$cfg" | sed "s/ID/$id/g")"
	(last=
	while :; do
		t=$(($(cat "$tz/temp") / 1000))
		if [ "$t" != "$last" ]; then
			mosquitto_pub "$@" -r -t "touchkio/$id/soc_temperature/state" -m "$t" && last=$t
		fi
		sleep 30
	done) &
fi

# commands: "off" or "on,brightness,red,green,blue" (empty = unchanged)
mosquitto_sub "$@" -t "$base/set" | while read -r cmd; do
	IFS=, read -r s b r g bl < "$store"
	if [ "$cmd" = off ]; then
		s=off
	else
		old=$IFS; IFS=,; set -f; set -- $cmd; set +f; IFS=$old
		s=on; b=${2:-$b}; r=${3:-$r}; g=${4:-$g}; bl=${5:-$bl}
		# restore the broker arguments for apply()
		set -- -h "$host" -p "$port"
		[ -n "${KIOSK_MQTT_USER:-}" ] && set -- "$@" -u "$KIOSK_MQTT_USER" -P "${KIOSK_MQTT_PASSWORD:-}"
	fi
	echo "$s,$b,$r,$g,$bl" > "$store"
	apply "$@"
done
