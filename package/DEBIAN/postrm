#!/bin/sh
set -e
units="kiosk.service wf2489t-mqtt.service wf2489t-autobrightness.service wf2489t-person.service aic8800-bluetooth.service"
case "$1" in
remove)
	deb-systemd-helper mask $units >/dev/null || true
	;;
purge)
	deb-systemd-helper purge $units >/dev/null || true
	deb-systemd-helper unmask $units >/dev/null || true
	rm -f /etc/default/kiosk
	rm -rf /var/lib/wf2489t-led
	;;
esac
