       if (output_channels == 1 && input_channels == 1 &&
           !operation->addition_input && (operation->add_tensor == -1)) {
          pipe_buffer_copy(pcontext, &input_tensor->base, input, 0, 0,
@@ -760,7 +796,7 @@ rkt_ml_subgraph_invoke(struct pipe_context *pcontext,
                            input_channels;
 
          if (stride == row) {
-            memcpy(map, inputs[i], row * operation->input_height);
+            memcpy(map, input_data, row * operation->input_height);
          } else {
             /*
