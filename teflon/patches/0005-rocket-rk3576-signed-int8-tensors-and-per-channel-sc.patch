diff --git a/src/gallium/drivers/rocket/rkt_int8.c b/src/gallium/drivers/rocket/rkt_int8.c
new file mode 100644
index 0000000..d3e9fdc
--- /dev/null
+++ b/src/gallium/drivers/rocket/rkt_int8.c
@@ -0,0 +1,228 @@
+/*
+ * Copyright (c) 2026 rk3576-npu-open contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Signed int8 tensors as offset uint8, see rkt_int8.h.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/macros.h"
+#include "util/u_inlines.h"
+
+#include "rkt_coefs.h"
+#include "rkt_int8.h"
+#include "rkt_ml.h"
+#include "rkt_task.h"
+
+void
+rkt_int8_flip(void *data, unsigned n)
+{
+   uint8_t *p = data;
+   for (unsigned i = 0; i < n; i++)
+      p[i] ^= 0x80;
+}
+
+/*
+ * Copy *src into the next slot of the view, moved into the uint8 domain:
+ * zero point(s) + 128, no longer signed. Only ever called on the 8-bit
+ * activations and weights, never on the int32 bias.
+ */
+static struct pipe_tensor *
+shift_tensor(struct rkt_int8_view *view, struct pipe_tensor *src,
+             unsigned channels)
+{
+   if (!src || !src->is_signed || view->tensor_count >= ARRAY_SIZE(view->tensors))
+      return src;
+
+   unsigned i = view->tensor_count++;
+   struct pipe_tensor *t = &view->tensors[i];
+
+   *t = *src;
+   t->zero_point = src->zero_point + 128;
+   t->is_signed = false;
+   if (src->zero_points && channels) {
+      view->zero_points[i] = malloc(channels * sizeof(int));
+      for (unsigned c = 0; c < channels; c++)
+         view->zero_points[i][c] = src->zero_points[c] + 128;
+      t->zero_points = view->zero_points[i];
+   }
+   return t;
+}
+
+/* A signed 8-bit tensor anywhere but in a convolution's int32 bias. */
+static bool
+has_signed_8bit(const struct pipe_ml_operation *poperation)
+{
+   bool conv = poperation->type == PIPE_ML_OPERATION_TYPE_CONVOLUTION;
+
+   for (unsigned i = 0; i < (conv ? 1 : poperation->input_count); i++)
+      if (poperation->input_tensors[i] && poperation->input_tensors[i]->is_signed)
+         return true;
+   for (unsigned i = 0; i < poperation->output_count; i++)
+      if (poperation->output_tensors[i] && poperation->output_tensors[i]->is_signed)
+         return true;
+   return conv && poperation->conv.weight_tensor &&
+          poperation->conv.weight_tensor->is_signed;
+}
+
+const struct pipe_ml_operation *
+rkt_int8_view(struct pipe_context *pcontext,
+              const struct pipe_ml_operation *poperation,
+              struct rkt_int8_view *view)
+{
+   memset(view, 0, sizeof(*view));
+
+   if (!has_signed_8bit(poperation) ||
+       poperation->input_count > ARRAY_SIZE(view->in_ptrs) ||
+       poperation->output_count > ARRAY_SIZE(view->out_ptrs))
+      return poperation;
+
+   bool conv = poperation->type == PIPE_ML_OPERATION_TYPE_CONVOLUTION;
+   struct pipe_tensor *w = conv ? poperation->conv.weight_tensor : NULL;
+   unsigned n = w ? w->dims[0] * w->dims[1] * w->dims[2] * w->dims[3] : 0;
+
+   /* Signed weights we cannot rewrite (not 8 bit, no data): leave it all. */
+   if (w && w->is_signed &&
+       (!w->resource || pipe_buffer_size(w->resource) != n))
+      return poperation;
+
+   view->op = *poperation;
+   view->op.input_tensors = view->in_ptrs;
+   view->op.output_tensors = view->out_ptrs;
+
+   /*
+    * The bias of a convolution is input 2 (int32, zero point 0, scale
+    * in_scale * w_scale). It is the same number in both domains, so it keeps
+    * pointing at the original tensor, like any input other than the
+    * activations.
+    */
+   for (unsigned i = 0; i < poperation->input_count; i++) {
+      struct pipe_tensor *t = poperation->input_tensors[i];
+      bool activation = !conv || i == 0;
+      view->in_ptrs[i] = activation ? shift_tensor(view, t, 0) : t;
+   }
+   for (unsigned i = 0; i < poperation->output_count; i++)
+      view->out_ptrs[i] = shift_tensor(view, poperation->output_tensors[i], 0);
+
+   if (w && w->is_signed) {
+      unsigned oc = poperation->output_tensors[0]->dims[3];
+      struct pipe_transfer *transfer;
+      const uint8_t *src =
+         pipe_buffer_map(pcontext, w->resource, PIPE_MAP_READ, &transfer);
+      uint8_t *tmp = malloc(n);
+
+      memcpy(tmp, src, n);
+      pipe_buffer_unmap(pcontext, transfer);
+      rkt_int8_flip(tmp, n);
+      view->weights = pipe_buffer_create_with_data(pcontext, 0,
+                                                   PIPE_USAGE_DEFAULT, n, tmp);
+      free(tmp);
+
+      struct pipe_tensor *wv = shift_tensor(view, w, oc);
+      wv->resource = view->weights;
+      view->op.conv.weight_tensor = wv;
+      if (poperation->input_count > 1 && poperation->input_tensors[1] == w)
+         view->in_ptrs[1] = wv;
+   }
+
+   return &view->op;
+}
+
+void
+rkt_int8_view_fini(struct rkt_int8_view *view)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(view->zero_points); i++)
+      free(view->zero_points[i]);
+   pipe_resource_reference(&view->weights, NULL);
+   memset(view, 0, sizeof(*view));
+}
+
+bool
+rkt_int8_c_q14(const struct rkt_operation *operation,
+               const struct pipe_ml_operation *poperation)
+{
+   return operation->soc == RKT_SOC_RK3576 &&
+          poperation->conv.weight_tensor->scales != NULL;
+}
+
+void
+rkt_int8_fix_coefs(struct pipe_context *pcontext,
+                   const struct pipe_ml_operation *poperation,
+                   const struct rkt_operation *operation)
+{
+   /* rkt_fill_biases() numbers its dumps the same way. */
+   static int dump_idx = 0;
+
+   if (operation->soc != RKT_SOC_RK3576 || getenv("ROCKET_RK3588_SDP"))
+      return;
+   int idx = dump_idx++;
+
+   bool firstconv = rkt_rk3576_firstconv(operation);
+   bool op2_fix = operation->int8 && !operation->c_q14 && !firstconv &&
+                  operation->input_channels <= 4 && !operation->depthwise;
+   if (!operation->c_q14 && !op2_fix)
+      return;
+
+   bool dw = operation->depthwise;
+   unsigned oc_n = operation->output_channels;
+   unsigned table_bytes = rkt_coef_table_bytes(dw, oc_n);
+   unsigned op2_off = firstconv
+                         ? 0x100
+                         : table_bytes + (getenv("ROCKET_SCALE_OFF")
+                                             ? 0 : rkt_scale_table_bytes(oc_n));
+   unsigned size = pipe_buffer_size(operation->biases);
+   struct pipe_transfer *transfer;
+   uint8_t *b8 = pipe_buffer_map(pcontext, operation->biases, PIPE_MAP_WRITE,
+                                 &transfer);
+
+   if (operation->c_q14) {
+      const float *wsc = poperation->conv.weight_tensor->scales;
+      float max = 0.0f;
+      for (unsigned oc = 0; oc < oc_n; oc++)
+         max = MAX2(max, wsc[oc]);
+
+      unsigned padded = dw ? oc_n : ALIGN(oc_n, 8);
+      for (unsigned oc = 0; oc < padded; oc++) {
+         unsigned src = MIN2(oc, oc_n - 1);
+         unsigned g = oc / 8, i = oc % 8;
+         unsigned off = dw ? g * 48 + 32 + i * 2 : g * 64 + 48 + i * 2;
+         float q14 = max > 0.0f ? wsc[src] / max * 16384.0f : 0.0f;
+         int c = (int)(q14 + 0.5f);
+         if (off + 2 > table_bytes)
+            continue;
+         /*
+          * A channel whose scale is below 2^-15 of the largest (dead channels
+          * at 1e-6 in movenet's first conv) would get C = 0. The vendor writes
+          * 1 and scales A by q14 / 1 so that A * C still carries the bias at
+          * the right size.
+          */
+         if (c == 0 && q14 > 0.0f) {
+            c = 1;
+            int32_t *a = (int32_t *)(b8 + (dw ? g * 48 : g * 64) + i * 4);
+            *a = (int32_t)((double)*a * q14 + (*a >= 0 ? 0.5 : -0.5));
+         }
+         *(int16_t *)(b8 + off) = (int16_t)MIN2(c, 16384);
+      }
+   }
+
+   /*
+    * The second operand word. The first conv encoder points 0x5024 at
+    * +0x100, which is past the record table only for <= 32 channels.
+    */
+   if (op2_off >= table_bytes && op2_off + 4 <= size)
+      *(uint32_t *)(b8 + op2_off) = operation->c_q14 ? 0x0e0e : 0x1004;
+
+   if (DBG_ENABLED(ROCKET_DBG_DUMP_BOS))
+      rkt_dump_buffer(b8, "biases", 0, idx, 0, size);
+   pipe_buffer_unmap(pcontext, transfer);
+}
+
+bool
+rkt_int8_raw_input(const struct rkt_operation *operation)
+{
+   return operation->soc == RKT_SOC_RK3576 && !operation->depthwise &&
+          operation->input_channels <= 4 &&
+          !rkt_rk3576_firstconv(operation);
+}
diff --git a/src/gallium/drivers/rocket/rkt_int8.h b/src/gallium/drivers/rocket/rkt_int8.h
new file mode 100644
index 0000000..d576b4d
--- /dev/null
+++ b/src/gallium/drivers/rocket/rkt_int8.h
@@ -0,0 +1,106 @@
+/*
+ * Copyright (c) 2026 rk3576-npu-open contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef RKT_INT8_H
+#define RKT_INT8_H
+
+#include <stdbool.h>
+
+#include "pipe/p_state.h"
+
+/*
+ * Signed int8 (TFLite kTfLiteInt8) tensors.
+ *
+ * Everything below the frontend in this driver is written for asymmetric
+ * uint8: a tensor byte q is fed to the hardware as q - 0x80, zero points are
+ * 0..255, weights are packed as w - 0x80 and the read-back adds 0x80. An int8
+ * tensor (q_s, zp_s) is the same real number as the uint8 tensor
+ * (q_s + 128, zp_s + 128) with the same scale, and q_u - 0x80 == q_s is
+ * exactly the int8 byte the vendor runtime hands the NPU (captures: input,
+ * weights, CNA pad value 0x1084 and DPU output offset all equal the raw int8
+ * values). So an int8 layer is lowered as its offset-uint8 twin:
+ *
+ *  - rkt_int8_view(): a copy of the operation whose 8-bit signed tensors have
+ *    zero_point(s) + 128 and is_signed = false, and whose int8 weight buffer is
+ *    replaced by a copy with every byte XOR 0x80 (int8 -> offset uint8). The
+ *    int32 bias is the same number in both domains and is not touched.
+ *  - the subgraph input of a signed tensor is XOR 0x80'd before the usual
+ *    uint8 conversion, the output after it.
+ *
+ * Nothing changes for a model without signed tensors.
+ */
+
+struct rkt_int8_view {
+   struct pipe_ml_operation op;
+   struct pipe_tensor *in_ptrs[4];
+   struct pipe_tensor *out_ptrs[2];
+   struct pipe_tensor tensors[8];
+   unsigned tensor_count;
+   int *zero_points[8];
+   struct pipe_resource *weights;
+};
+
+/*
+ * Returns poperation itself when it has no signed 8-bit tensor (or the
+ * conversion is disabled), otherwise view->op. rkt_int8_view_fini() frees what
+ * the view allocated; call it once the operation is lowered.
+ */
+const struct pipe_ml_operation *
+rkt_int8_view(struct pipe_context *pcontext,
+              const struct pipe_ml_operation *poperation,
+              struct rkt_int8_view *view);
+
+void rkt_int8_view_fini(struct rkt_int8_view *view);
+
+/*
+ * Per-channel (per-axis) weight scales, i.e. every int8 TFLite conv.
+ *
+ * The DPU applies, per output channel (a model fitted to vendor runtime
+ * captures, which reproduces the vendor's outputs):
+ *
+ *    out = clamp(((MAC + A[oc]) * C[oc] >> s) * OUT_CVT_SCALE >> OUT_CVT_SHIFT
+ *                + offset)
+ *
+ * with C the int16 in the A/B/C (A/C for depthwise) record and s the low byte
+ * of the 16-bit word 0x5024 points at. The vendor writes C = Q14 of
+ * wt_sc[oc] / max(wt_sc), the word 0x0E0E (s = 14) and OUT_CVT from
+ * in_sc * max(wt_sc) / out_sc. C = 16 * wt_sc[oc] / max with the word 0x1004
+ * (s = 4) and OUT_CVT from the mean weight scale would leave every channel off
+ * by max/mean and quantised to 4 bits. Per-tensor layers (C = 16 everywhere)
+ * keep 0x1004.
+ *
+ * rkt_int8_c_q14() decides (RK3576, per-axis weights); lower_convolution()
+ * then takes the maximum scale
+ * for OUT_CVT and rkt_int8_fix_coefs() rewrites C and the word after
+ * rkt_fill_biases(). The first conv encoder drops its extra 4 bits of shift.
+ *
+ * rkt_int8_fix_coefs() also writes the 0x1004 word for a per-tensor int8 layer
+ * with <= 4 input channels on the generic encoder (yolox's first conv), where
+ * rkt_fill_biases() leaves it 0, i.e. C = 16 taken unshifted.
+ */
+struct rkt_operation;
+struct rkt_ml_subgraph;
+
+bool rkt_int8_c_q14(const struct rkt_operation *operation,
+                    const struct pipe_ml_operation *poperation);
+
+void rkt_int8_fix_coefs(struct pipe_context *pcontext,
+                        const struct pipe_ml_operation *poperation,
+                        const struct rkt_operation *operation);
+
+/*
+ * The RK3576 generic encoder takes a <= 4 channel, non-depthwise input
+ * (yolox's 3 channel first conv, micronet's 1 channel one) as a tight NHWC
+ * copy with the CNA CVT bypassed, so the bytes reach the MAC unchanged: such
+ * an int8 input has to stay int8 (as the vendor runtime feeds it: raw input,
+ * CVT 0x00010001, offsets 0). The first conv encoder (rkt_rk3576_firstconv) has
+ * its CVT subtract 128 and takes offset uint8 like everything else.
+ */
+bool rkt_int8_raw_input(const struct rkt_operation *operation);
+
+/* XOR 0x80 over n bytes, in place. */
+void rkt_int8_flip(void *data, unsigned n);
+
+#endif /* RKT_INT8_H */
