@@ -83,7 +83,13 @@ calc_explicit_padding(const struct rkt_operation *operation,
                       unsigned *pad_top, unsigned *pad_bottom,
                       unsigned *pad_left, unsigned *pad_right)
 {
-   if (operation->padding_same && operation->weights_width > 1) {
