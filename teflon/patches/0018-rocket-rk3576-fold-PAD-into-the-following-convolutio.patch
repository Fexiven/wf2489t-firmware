+      *pad_right = operation->pad_r;
+      *pad_top = operation->pad_t;
+      *pad_bottom = operation->pad_b;
+   } else if (operation->padding_same && operation->weights_width > 1) {
       /* Convert from implicit to explicit padding */
       unsigned pad_along_width =
          MAX2((operation->output_width - 1) * operation->stride +
