       if (!ok) {
          supported[i] = false;
          changed = true;
@@ -1488,6 +1619,14 @@ rkt_ml_subgraph_create(struct pipe_context *pcontext,
          lower_concat_rk3576(subgraph, &poperations[i], &operation);
