+/*
+ * A concatenation whose inputs do not all start at a multiple of 16
+ * channels (except the last), such as YOLOX's 4 + 1 + 80 channel heads.
+ */
+static bool
+concat_needs_pack(const struct pipe_ml_operation *poperation)
+{
+   for (unsigned k = 0; k + 1 < poperation->input_count; k++)
+      if (poperation->input_tensors[k]->dims[3] % FEATURE_ATOMIC_SIZE)
+         return true;
+   return false;
+}
+
+/*
+ * The 1x1 convolution after a concatenation with a padded layout
+ * (lower_concat_rk3576): from the internal tensor padded_index, which holds
+ * input k at channel ALIGN(c_0, 16) + ... + ALIGN(c_k-1, 16), to the real
+ * output. Output channel o reads its input channel with weight 1 and every
+ * other channel with weight 0; input and output have the same quantization,
+ * so the requantization is an exact 1.0. This is how rknn-toolkit2 packs a
+ * concatenation at channel offsets that are not multiples of 16 (copy tasks
+ * into a padded buffer and a convolution "restride").
+ */
+static void
+lower_concat_pack_rk3576(struct rkt_ml_subgraph *subgraph,
+                         const struct pipe_ml_operation *poperation,
+                         unsigned padded_index, unsigned cpad,
+                         struct rkt_operation *operation)
+{
+   struct pipe_context *pcontext = subgraph->base.context;
+   struct pipe_tensor *o = poperation->output_tensors[0];
+   unsigned oc = o->dims[3];
+   struct pipe_tensor in = *o, w = {0}, b = {0};
+   struct pipe_tensor *inputs[3] = {&in, &w, &b};
+   struct pipe_ml_operation conv = {0};
+   uint8_t *wdata = calloc(oc, cpad);
+   int32_t *bdata = calloc(oc, sizeof(int32_t));
+   unsigned c0 = 0, g0 = 0;
+
+   for (unsigned k = 0; k < poperation->input_count; k++) {
+      unsigned c = poperation->input_tensors[k]->dims[3];
+      for (unsigned j = 0; j < c; j++)
+         wdata[(c0 + j) * cpad + g0 + j] = 1;
+      c0 += c;
+      g0 += ALIGN(c, FEATURE_ATOMIC_SIZE);
+   }
+
+   in.resource = NULL;
+   in.index = padded_index;
+   in.dims[3] = cpad;
+   w.dims[0] = oc;
+   w.dims[1] = w.dims[2] = 1;
+   w.dims[3] = cpad;
+   w.scale = 1.0f;
+   w.is_signed = o->is_signed;
+   w.resource = pipe_buffer_create_with_data(pcontext, 0, PIPE_USAGE_DEFAULT,
+                                             oc * cpad, wdata);
+   b.dims[0] = oc;
+   b.dims[1] = b.dims[2] = b.dims[3] = 1;
+   b.scale = o->scale;
+   b.is_signed = true;
+   b.resource = pipe_buffer_create_with_data(pcontext, 0, PIPE_USAGE_DEFAULT,
+                                             oc * sizeof(int32_t), bdata);
+   free(wdata);
+   free(bdata);
+
+   conv.type = PIPE_ML_OPERATION_TYPE_CONVOLUTION;
+   conv.input_tensors = inputs;
+   conv.input_count = 3;
+   conv.output_tensors = poperation->output_tensors;
+   conv.output_count = 1;
+   conv.conv.weight_tensor = &w;
+   conv.conv.bias_tensor = &b;
+   conv.conv.stride_x = conv.conv.stride_y = 1;
+   conv.conv.pointwise = true;
+   conv.conv.dilation_width_factor = conv.conv.dilation_height_factor = 1;
+
+   struct rkt_int8_view view;
+   const struct pipe_ml_operation *pop = rkt_int8_view(pcontext, &conv, &view);
+   operation->add_tensor = -1;
+   operation->int8 = pop != &conv;
+   operation->in_signed = in.is_signed;
+   lower_convolution(subgraph, pop, operation);
+   rkt_int8_view_fini(&view);
+
+   pipe_resource_reference(&w.resource, NULL);
+   pipe_resource_reference(&b.resource, NULL);
+}
+
 static void
 lower_concat_rk3576(struct rkt_ml_subgraph *subgraph,
                     const struct pipe_ml_operation *poperation,
@@ -857,6 +951,25 @@ lower_concat_rk3576(struct rkt_ml_subgraph *subgraph,
    operation->output_zero_point = rkt_ew_zp(o) + 0x80;
    operation->output_scale = o->scale;
 
+   /*
+    * Every input starts at a 16-channel group of the concatenation's buffer
+    * (place_concat_views). When an input other than the last has a channel
+    * count that is not a multiple of 16, that buffer is not the output's
+    * layout: it becomes an internal tensor of the padded channel count, and
+    * a 1x1 convolution after the concatenation packs its channels
+    * (lower_concat_pack_rk3576).
+    */
+   if (concat_needs_pack(poperation)) {
+      unsigned cpad = 0;
+      for (unsigned k = 0; k < n; k++)
