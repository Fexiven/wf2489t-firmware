  * rank come with leading dimensions of 1, so axis 3 / -1 is their last axis.
  */
 static bool
@@ -990,15 +1108,16 @@ rkt_concat_supported(const struct pipe_ml_operation *operation)
           i->is_signed != o->is_signed)
          return false;
       if (i->dims[0] != 1 || i->dims[1] != o->dims[1] ||
-          i->dims[2] != o->dims[2] || i->dims[3] <= 4)
-         return false;
-      if (k + 1 < operation->input_count && i->dims[3] % FEATURE_ATOMIC_SIZE)
+          i->dims[2] != o->dims[2] || !i->dims[3])
          return false;
       for (unsigned j = 0; j < k; j++)
          if (operation->input_tensors[j]->index == i->index)
             return false;
       c += i->dims[3];
    }
+   /* the packing convolution is only tested with int8 tensors */
+   if (concat_needs_pack(operation) && !o->is_signed)
+      return false;
    return c == o->dims[3];
 }
 
@@ -1346,6 +1465,18 @@ drop_misplaced(struct rkt_ml_graph *g, bool *supported)
                if (ops[i].input_tensors[j] == ops[k].input_tensors[l])
