+/*
+ * Requantisation as TFLite does it (RK3576 regular and first-conv encoders).
+ *
+ * Measured on the board, bit for bit on every layer checked, the DPU output
+ * stage is
+ *
+ *    u   = round_half_even((MAC + A[oc]) * C[oc] / 2^s)      (u: 32 bits)
+ *    out = clamp(round_half_up(u * OUT_CVT_SCALE / 2^OUT_CVT_SHIFT) + offset)
+ *
+ * with s from the word 0x5024 points at (both bytes; the vendor writes
+ * 0x0E0E) and MAC + A equal to TFLite's int32 accumulator. TFLite rounds
+ * acc * M[oc] once, M = in_sc * wt_sc[oc] / out_sc in fp32. The encodings
+ * used before (C = 16 with the word 0x1004 per tensor, C = Q14 of
+ * wt_sc / max with 0x0E0E per channel, a 15 bit OUT_CVT from the mantissa)
+ * quantise M to 15 bits, round twice, and on per-channel layers give a
+ * channel with a small scale a C of a few counts: a dead channel (scale
+ * 1e-6) with a large bias came out up to 13 off, as with the vendor runtime.
+ * The word 0x1004 also clamps negative values to 0 before the offset, which
+ * the lift (rkt_out_lift) worked around by adding out_zp / M to A rounded to
+ * an integer.
+ *
+ * Here:
+ *  - per tensor: the C (15 bit) and OUT_CVT (15 bit) pair whose product is
+ *    closest to M; most fp32 scales factor exactly, the rest are within
+ *    about 2^-27;
+ *  - per channel: OUT_CVT from the largest M, C[oc] the rest of M[oc] over
+ *    the int16 range; A[oc] is scaled by the exact C over the rounded one, so
+ *    the bias comes out right and only the MAC sees the rounding of C;
+ *  - s the smallest shift that keeps u in 32 bits for any input (the board's
+ *    u wraps beyond), written into both bytes of the word;
+ *  - no lift, the offset takes the output zero point directly.
+ *
+ * rkt_rq_exact() decides (lower_convolution(), before rkt_fill_biases(),
+ * which then folds no lift into A), rkt_rq_exact_coefs() rewrites C, A and the
+ * word after it and sets rq_cvt/rq_shift for the encoders.
+ */
+bool rkt_rq_exact(const struct rkt_operation *operation);
+
+void rkt_rq_exact_coefs(struct pipe_context *pcontext,
+                        const struct pipe_ml_operation *poperation,
+                        struct rkt_operation *operation);
+
 /*
  * The RK3576 generic encoder takes a <= 4 channel, non-depthwise input
  * (yolox's 3 channel first conv, micronet's 1 channel one) as a tight NHWC
