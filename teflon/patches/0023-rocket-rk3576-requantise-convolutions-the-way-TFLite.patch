diff --git a/src/gallium/drivers/rocket/rkt_int8.c b/src/gallium/drivers/rocket/rkt_int8.c
index ebd0031..55b0b1d 100644
--- a/src/gallium/drivers/rocket/rkt_int8.c
+++ b/src/gallium/drivers/rocket/rkt_int8.c
@@ -5,6 +5,7 @@
  * Signed int8 tensors as offset uint8, see rkt_int8.h.
  */
 
+#include <math.h>
 #include <stdlib.h>
 #include <string.h>
 
@@ -155,7 +156,8 @@ rkt_int8_fix_coefs(struct pipe_context *pcontext,
    /* rkt_fill_biases() numbers its dumps the same way. */
    static int dump_idx = 0;
 
-   if (operation->soc != RKT_SOC_RK3576 || getenv("ROCKET_RK3588_SDP"))
+   if (operation->soc != RKT_SOC_RK3576 || getenv("ROCKET_RK3588_SDP") ||
+       operation->rq_exact)
       return;
    int idx = dump_idx++;
 
@@ -241,3 +243,236 @@ rkt_int8_raw_input(const struct rkt_operation *operation)
       return operation->in_signed;
    return true;
 }
+
+/*
+ * C is an int16 (at most 32767); OUT_CVT_SCALE takes 15 bits (0x8000 and up
+ * gave garbage on the board).
+ */
+#define RQ_C_MAX     32767
+#define RQ_C_BITS    15
+#define RQ_CVT_BITS  15
+
+bool
+rkt_rq_exact(const struct rkt_operation *operation)
+{
+   return operation->soc == RKT_SOC_RK3576 && !operation->ew_add &&
+          operation->ops.kind == RKT_OPS_NONE &&
+          (operation->depthwise || operation->input_channels > 4 ||
+           rkt_rk3576_firstconv(operation));
+}
+
+/* the shift that puts m * 2^shift in [2^(bits - 1), 2^bits) */
+static int
+rq_norm_shift(double m, int bits)
+{
+   int e;
+
+   frexp(m, &e); /* m = f * 2^e, f in [0.5, 1) */
+   return bits - e;
+}
+
+/*
+ * Per-tensor: C (cbits) and cvt (RQ_CVT_BITS) with C * cvt / 2^shift closest
+ * to m. Returns the relative error.
+ */
+static double
+rq_pair(double m, unsigned *c_out, unsigned *cvt_out, unsigned *shift_out)
+{
+   int cbits = RQ_C_BITS;
+   int shift = rq_norm_shift(m, cbits + RQ_CVT_BITS - 1);
+   double t = ldexp(m, shift); /* in [2^(cbits + 13), 2^(cbits + 14)) */
+   double best = INFINITY;
+   unsigned bc = 1u << (cbits - 1), bv = 0;
+
+   for (unsigned c = 1u << (cbits - 1); c < (1u << cbits) && c <= RQ_C_MAX; c++) {
+      double v = nearbyint(t / c);
+      if (v < 1 || v >= (1u << RQ_CVT_BITS))
+         continue;
+      double err = fabs(c * v - t);
+      if (err < best) {
+         best = err;
+         bc = c;
+         bv = (unsigned)v;
+         if (err == 0)
+            break;
+      }
+   }
+   *c_out = bc;
+   *cvt_out = bv;
+   *shift_out = shift;
+   return best / t;
+}
+
+void
+rkt_rq_exact_coefs(struct pipe_context *pcontext,
+                   const struct pipe_ml_operation *poperation,
+                   struct rkt_operation *operation)
+{
+   /* rkt_fill_biases() numbers its dumps the same way. */
+   static int dump_idx = 0;
+
+   if (!operation->rq_exact)
+      return;
+   int idx = dump_idx++;
+
+   bool dw = operation->depthwise;
+   unsigned oc_n = operation->output_channels;
+   unsigned rec = dw ? 48 : 64, c_off = dw ? 32 : 48;
+   unsigned table_bytes = rkt_coef_table_bytes(dw, oc_n);
+   /* where the encoders point 0x5024: the first-conv encoder right after
+    * the record table, the regular one after the fp16 scale table too */
+   bool firstconv = rkt_rk3576_firstconv(operation);
+   unsigned op2_off = table_bytes + (firstconv || getenv("ROCKET_SCALE_OFF")
+                                        ? 0 : rkt_scale_table_bytes(oc_n));
+   unsigned size = pipe_buffer_size(operation->biases);
+   const float *wsc = poperation->conv.weight_tensor->scales;
+   float in_sc = poperation->input_tensors[0]->scale;
+   float out_sc = poperation->output_tensors[0]->scale;
+   unsigned padded = dw ? oc_n : ALIGN(oc_n, 8);
+   double *m = calloc(oc_n, sizeof(double));
+   int32_t *a_new = malloc(padded * sizeof(int32_t));
+   int16_t *c_new = malloc(padded * sizeof(int16_t));
+   double m_max = 0.0;
+   bool per_tensor = true;
+   unsigned cvt = 1, shift = 0;
+
+   /* the fp32 multiplier TFLite's kernels use: (in * w) / out */
+   for (unsigned oc = 0; oc < oc_n; oc++) {
+      float w = wsc ? wsc[oc] : poperation->conv.weight_tensor->scale;
+      m[oc] = (double)((in_sc * w) / out_sc);
+      m_max = MAX2(m_max, m[oc]);
+      per_tensor &= m[oc] == m[0];
+   }
+
+   if (per_tensor) {
+      unsigned c;
+      rq_pair(m[0], &c, &cvt, &shift);
+   } else {
+      /*
+       * OUT_CVT from the largest multiplier. Two candidates: the largest C
+       * at the top of the int16 range (the finest steps for the small
+       * channels), and the per-tensor pair of the largest multiplier (exact
+       * for every channel whose scale is a power-of-two fraction of it). The
+       * one with the smaller summed relative error of C wins.
+       */
+      unsigned cand_cvt[2], cand_shift[2], c0;
+      cand_shift[0] = rq_norm_shift(m_max, RQ_C_BITS + RQ_CVT_BITS);
+      cand_cvt[0] = (unsigned)ceil(ldexp(m_max, cand_shift[0]) / (RQ_C_MAX + 0.5));
+      while (cand_cvt[0] >= (1u << RQ_CVT_BITS)) {
+         cand_cvt[0] = (cand_cvt[0] + 1) / 2;
+         cand_shift[0]--;
+      }
+      rq_pair(m_max, &c0, &cand_cvt[1], &cand_shift[1]);
+      double best = INFINITY;
+      for (unsigned k = 0; k < 2; k++) {
+         double err = 0.0;
+         for (unsigned oc = 0; oc < oc_n; oc++) {
+            double x = ldexp(m[oc], cand_shift[k]) / cand_cvt[k];
+            double c = CLAMP(nearbyint(x), 1, RQ_C_MAX);
+            err += fabs(c - x) / x;
+         }
+         if (err < best) {
+            best = err;
+            cvt = cand_cvt[k];
+            shift = cand_shift[k];
+         }
+      }
+   }
+
+   struct pipe_transfer *transfer;
+   uint8_t *b8 = pipe_buffer_map(pcontext, operation->biases,
+                                 PIPE_MAP_READ | PIPE_MAP_WRITE, &transfer);
+
+   /*
+    * C[oc] = M[oc] * 2^shift / cvt rounded (at least 1), and A scaled by the
+    * exact C over the rounded one. Channels past oc_n repeat the last one, as
+    * rkt_fill_biases() lays them out.
+    */
+   for (unsigned oc = 0; oc < padded; oc++) {
+      unsigned src = MIN2(oc, oc_n - 1);
+      unsigned off = (oc / 8) * rec + (oc % 8) * 4;
+      unsigned soff = (src / 8) * rec + (src % 8) * 4;
+      double c_exact = ldexp(m[src], shift) / cvt;
+      long c = lround(c_exact);
+
+      if (off + 4 > table_bytes || soff + 4 > table_bytes)
+         continue;
+      c = CLAMP(c, 1, RQ_C_MAX);
+      int32_t a = *(int32_t *)(b8 + soff);
+      double a_x = nearbyint((double)a * c_exact / c);
+      c_new[oc] = (int16_t)c;
+      a_new[oc] = (int32_t)CLAMP(a_x, (double)INT32_MIN, (double)INT32_MAX);
+   }
+   for (unsigned oc = 0; oc < padded; oc++) {
+      unsigned off = (oc / 8) * rec + (oc % 8) * 4;
+      unsigned coff = (oc / 8) * rec + c_off + (oc % 8) * 2;
+
+      if (off + 4 > table_bytes || coff + 2 > table_bytes)
+         continue;
+      *(int32_t *)(b8 + off) = a_new[oc];
+      *(int16_t *)(b8 + coff) = c_new[oc];
+   }
+
+   /*
+    * u = (MAC + A) * C >> s is held in 32 bits (beyond that the board's
+    * results wrap), and MAC + A is TFLite's accumulator. Bound it for any
+    * input, |bias| + max|x - in_zp| * sum|w - wt_zp| per channel, and take
+    * the smallest s that keeps every channel's u in range. u keeps at least
+    * 2^14 steps per output step, so its rounding is at most 2^-15 of one.
+    */
+   unsigned kw = poperation->conv.weight_tensor->dims[1];
+   unsigned kh = poperation->conv.weight_tensor->dims[2];
+   unsigned ic_n = poperation->input_tensors[0]->dims[3];
+   unsigned xmax = MAX2(operation->input_zero_point,
+                        255 - operation->input_zero_point);
+   const int *wzp = poperation->conv.weight_tensor->zero_points;
+   struct pipe_transfer *btransfer, *wtransfer;
+   const int32_t *bias =
+      poperation->conv.bias_tensor
+         ? pipe_buffer_map(pcontext, poperation->conv.bias_tensor->resource,
+                           PIPE_MAP_READ, &btransfer)
+         : NULL;
+   const uint8_t *w8 = pipe_buffer_map(pcontext,
+                                       poperation->conv.weight_tensor->resource,
+                                       PIPE_MAP_READ, &wtransfer);
+   unsigned s1 = 0;
+   for (unsigned oc = 0; oc < oc_n; oc++) {
+      int zw = wzp ? wzp[oc] : poperation->conv.weight_tensor->zero_point;
+      double wsum = 0.0;
+      for (unsigned t = 0; t < kw * kh; t++) {
+         if (dw) {
+            wsum += abs((int)w8[t * ic_n + oc] - zw);
+         } else {
+            for (unsigned ic = 0; ic < ic_n; ic++)
+               wsum += abs((int)w8[(oc * kw * kh + t) * ic_n + ic] - zw);
+         }
+      }
+      double bound = (bias ? fabs((double)bias[oc]) : 0.0) + xmax * wsum;
+      double c = (double)c_new[oc];
+      while (bound * c >= ldexp(1.0, 31 + s1) - 1)
+         s1++;
+   }
+   pipe_buffer_unmap(pcontext, wtransfer);
+   if (bias)
+      pipe_buffer_unmap(pcontext, btransfer);
+   s1 = MIN2(s1, shift);
+
+   /*
+    * The second operand word: the stage 1 shift in both bytes, as the vendor
+    * writes 0x0E0E. A different high byte (0x1004) clamps negative results
+    * to 0 before the offset.
+    */
+   if (op2_off + 4 <= size)
+      *(uint32_t *)(b8 + op2_off) = (s1 << 8) | s1;
+
+   operation->rq_cvt = cvt;
+   operation->rq_shift = shift - s1;
+
+   if (DBG_ENABLED(ROCKET_DBG_DUMP_BOS))
+      rkt_dump_buffer(b8, "biases", 0, idx, 0, size);
+   pipe_buffer_unmap(pcontext, transfer);
+
+   free(m);
+   free(a_new);
+   free(c_new);
+}
