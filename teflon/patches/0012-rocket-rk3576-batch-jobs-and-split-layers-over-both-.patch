@@ -0,0 +1,46 @@
+/*
+ * Copyright (c) 2026 rk3576-npu-open contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef RKT_MC_H
+#define RKT_MC_H
+
+#include "rkt_ml.h"
+
+/*
+ * RK3576 two-core split.
+ *
+ * Each operation gets an output row range per core (rkt_mc_plan). Core 0
+ * computes its range with the normal single-core CBUF layout (data banks from
+ * 0, weights up to bank 7), core 1 with the layout the vendor runtime compiles
+ * for a model pinned to core 1 (data banks from 7, weights up to bank 14).
+ * Both load their own weights and nothing is shared between the cores, so the
+ * result is the same whether the two jobs run in parallel or one after the
+ * other.
+ */
+enum rkt_mc_mode {
+   RKT_MC_OFF = 0,
+   RKT_MC_SPLIT = 1,
+};
+
+/*
+ * Plan per-core output row ranges for the whole subgraph, before the
+ * operations are split into tasks. Done when the kernel can pin jobs to the
+ * two cores; ROCKET_MULTICORE=0 keeps everything on core 0.
+ */
+void rkt_mc_plan(struct rkt_ml_subgraph *subgraph);
+
+/* input rows [*lo, *hi) that output rows [r0, r1) of this operation read */
+void rkt_mc_in_rows(const struct rkt_operation *operation, unsigned r0,
+                    unsigned r1, unsigned *lo, unsigned *hi);
+
+/* the cores jobs can be pinned to (DRM_ROCKET_PARAM_NUM_CORES, 0 if unknown) */
+void rkt_mc_init(enum rkt_soc soc, unsigned pin_cores);
+
+/* rewrite the CBUF placement registers of one task for its core */
+void rkt_mc_fixup_regcmd(const struct rkt_operation *operation,
+                         const struct split_task *task,
+                         struct util_dynarray *regs);
+
+#endif /* RKT_MC_H */
