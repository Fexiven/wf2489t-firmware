diff --git a/src/gallium/drivers/rocket/rkt_mc.c b/src/gallium/drivers/rocket/rkt_mc.c
new file mode 100644
index 0000000..811b0ad
--- /dev/null
+++ b/src/gallium/drivers/rocket/rkt_mc.c
@@ -0,0 +1,259 @@
+/*
+ * Copyright (c) 2026 rk3576-npu-open contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * RK3576 two-core layer split, derived from vendor runtime captures of
+ * layers run with core mask 0x3 and pinned to either core.
+ *
+ * What the vendor does with core mask 0x3, per layer:
+ *  - one submit with two subcore task ranges, one task (or window chain) per
+ *    core; core 0 gets output rows [0, mid), core 1 rows [mid, oh), mid = oh/2
+ *  - every address and geometry register is that of a row window: the input
+ *    and output pointers move by the first row, pad_top only on core 0 and
+ *    pad_bottom only on core 1, exactly like two windows of a single-core split
+ *  - the CBUF is ONE 16 bank array the two cores share, so the halves must not
+ *    overlap in it. These registers place them (B = first data bank, D = data
+ *    banks, entries are 1024 x 64 bytes a bank):
+ *      0x1018  [15:8] D, [7:0] B + D               (bit 31: data reuse)
+ *      0x103c  [15:0] read pointer + B * 1024
+ *      0x1040  [31:24] 4 * first weight bank, [15:0] write pointer + B * 1024
+ *      0x1038  [7:0] end of the weight banks (0x07 core 0, 0x0e core 1 when the
+ *              layer runs on one core; 0x10 with both), bit 8 on the core 1
+ *              single-core layout, bit 31: the weights are already in the CBUF
+ *  - the single-core layout for core 1 (vendor tasks 7..13 of mdet_000 /
+ *    5..9 of inc_003) is the core 0 one moved by 7 banks.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "rkt_mc.h"
+#include "rkt_task.h"
+
+#define MC_TGT_CNA 0x0201
+/* fewest output rows per core worth splitting */
+#define MC_MIN_ROWS 4
+/* halo rows (in percent of the rows) and recomputed MACs an operation may
+ * cost before it is cut into plain halves instead */
+#define MC_OVERLAP 50
+#define MC_HALO_MACS (4u << 20)
+
+/*
+ * The region split is used when the kernel can pin jobs to the two cores
+ * (DRM_ROCKET_PARAM_NUM_CORES >= 2). Without pinning both cores' jobs would
+ * run one after the other, so the recomputed halo rows would only cost time.
+ */
+static bool mc_enabled;
+
+void
+rkt_mc_init(enum rkt_soc soc, unsigned pin_cores)
+{
+   const char *s = getenv("ROCKET_MULTICORE");
+
+   mc_enabled = soc == RKT_SOC_RK3576 && pin_cores >= 2 && !(s && atoi(s) == 0);
+}
+
+static inline uint32_t
+mc_val(uint64_t w)
+{
+   return (uint32_t)(w >> 16);
+}
+
+static inline uint64_t
+mc_set(uint64_t w, uint32_t v)
+{
+   return (w & 0xffff00000000ffffull) | ((uint64_t)v << 16);
+}
+
+void
+rkt_mc_fixup_regcmd(const struct rkt_operation *operation,
+                    const struct split_task *task,
+                    struct util_dynarray *regs)
+{
+   const unsigned base = 7; /* first data bank of core 1 */
+
+   if (operation->multicore == RKT_MC_OFF || task->mc_core == 0)
+      return; /* the normal single-core layout */
+
+   util_dynarray_foreach (regs, uint64_t, w) {
+      uint32_t v = mc_val(*w);
+
+      if ((*w >> 48) != MC_TGT_CNA)
+         continue;
+
+      switch (*w & 0xffff) {
+      case 0x1018: {
+         unsigned d = (v >> 8) & 0xff;
+         v = (v & 0xffff0000) | (d << 8) | ((base + d) & 0xff);
+         break;
+      }
+      case 0x1038:
+         v = (task->mc_first ? 0 : (v & 0x80000000)) | 0x10e;
+         break;
+      case 0x103c:
+         v = (v & 0xffff0000) | (((v & 0xffff) + base * 1024) & 0xffff);
+         break;
+      case 0x1040: {
+         unsigned wbank4 = (v >> 24) & 0xff; /* 4 x first weight bank */
+         wbank4 += 4 * base;
+         v = (wbank4 << 24) | (v & 0x00ff0000) |
+             (((v & 0xffff) + base * 1024) & 0xffff);
+         break;
+      }
+      default:
+         continue;
+      }
+      *w = mc_set(*w, v);
+   }
+}
+
+void
+rkt_mc_in_rows(const struct rkt_operation *operation, unsigned r0, unsigned r1,
+               unsigned *lo, unsigned *hi)
+{
+   unsigned pad_top, pad_bottom, pad_left, pad_right;
+   int l, h;
+
+   if (r0 >= r1) {
+      *lo = *hi = 0;
+      return;
+   }
+   if (operation->ew_add) {
+      /* element-wise: the same rows */
+      *lo = r0;
+      *hi = r1;
+      return;
+   }
+
+   rkt_calc_explicit_padding(operation, &pad_top, &pad_bottom, &pad_left,
+                             &pad_right);
+   l = (int)(r0 * operation->stride) - (int)pad_top;
+   h = (int)((r1 - 1) * operation->stride) - (int)pad_top +
+       (int)operation->weights_height; /* exclusive */
+   *lo = MAX2(l, 0);
+   *hi = MIN2(MAX2(h, 0), (int)operation->input_height);
+   if (*lo >= *hi)
+      *lo = *hi = 0;
+}
+
+/* an operation the RK3576 row-window splitter can give any row range */
+static bool
+mc_region_ok(const struct rkt_operation *operation)
+{
+   return operation->soc == RKT_SOC_RK3576 &&
+          operation->output_height >= 2 * MC_MIN_ROWS &&
+          (operation->ew_add || (!operation->addition_input &&
+                                 operation->add_tensor == -1 &&
+                                 operation->input_channels > 4 &&
+                                 !rkt_rk3576_firstconv(operation)));
+}
+
+static void
+mc_hull(unsigned *lo, unsigned *hi, unsigned l, unsigned h)
+{
+   if (l >= h)
+      return;
+   if (*lo >= *hi) {
+      *lo = l;
+      *hi = h;
+   } else {
+      *lo = MIN2(*lo, l);
+      *hi = MAX2(*hi, h);
+   }
+}
+
+/*
+ * Region split. Going backwards through the subgraph,
+ * every splittable operation computes on core c the output rows its
+ * consumers on core c read, plus its own half of the rows (so that all rows
+ * exist for readers outside the subgraph). Where the two ranges overlap by
+ * more than MC_OVERLAP percent of the rows (halo rows add up through
+ * 3x3 layers, and double at every stride 2), the operation falls back to
+ * plain halves and its consumers fetch the missing rows from the other core
+ * (rkt_batch_jobs then cuts the jobs there). Operations that cannot be split
+ * run on core 0, whole.
+ *
+ * So a chain of layers runs as one job per core with no cross-core wait at
+ * all, at the price of recomputing the halo rows. The CBUF placement of core
+ * 1 is the vendor's single-core core 1 window (rkt_mc_fixup_regcmd), so the
+ * two cores never share banks.
+ */
+void
+rkt_mc_plan(struct rkt_ml_subgraph *subgraph)
+{
+   unsigned n = util_dynarray_num_elements(&subgraph->operations,
+                                           struct rkt_operation);
+   struct rkt_operation *ops = util_dynarray_begin(&subgraph->operations);
+   unsigned (*need)[2][2];
+
+   if (!mc_enabled || !n || getenv("ROCKET_WHOLE_GRAPH"))
+      return;
+
+   need = calloc(n, sizeof(*need)); /* need[i][core] = {lo, hi} */
+
+   for (int i = n - 1; i >= 0; i--) {
+      struct rkt_operation *op = &ops[i];
+      unsigned oh = op->output_height;
+      unsigned r[2][2] = {{0, oh}, {0, 0}};
+
+      if (mc_region_ok(op)) {
+         unsigned mid = DIV_ROUND_UP(oh, 2);
+         bool cut;
+
+         uint64_t row_macs = (uint64_t)op->output_width * op->output_channels *
+                             MAX2(op->weights_width * op->weights_height, 1) *
+                             (op->depthwise || op->ew_add ? 1 : op->input_channels);
+         unsigned extra;
+
+         r[0][0] = need[i][0][0];
+         r[0][1] = need[i][0][1];
+         r[1][0] = need[i][1][0];
+         r[1][1] = need[i][1][1];
+         /*
+          * Recompute only for consumers on BOTH cores; rows that only one
+          * core's consumers read are better fetched from the other core.
+          */
+         cut = r[0][0] >= r[0][1] || r[1][0] >= r[1][1];
+         mc_hull(&r[0][0], &r[0][1], 0, mid);
+         mc_hull(&r[1][0], &r[1][1], mid, oh);
+         extra = (r[0][1] - r[0][0]) + (r[1][1] - r[1][0]) - oh;
+         cut |= extra > oh * MC_OVERLAP / 100 || extra * row_macs > MC_HALO_MACS;
+         if (cut) {
+            r[0][0] = 0;
+            r[0][1] = mid;
+            r[1][0] = mid;
+            r[1][1] = oh;
+         }
+         op->mc_planned = true;
+      }
+
+      for (unsigned c = 0; c < 2; c++) {
+         op->mc_r0[c] = r[c][0];
+         op->mc_r1[c] = r[c][1];
+      }
+
+      /* what this operation's core c part reads from its producers */
+      int inputs[2] = {op->input_index, op->add_tensor};
+      for (unsigned k = 0; k < 2; k++) {
+         if (inputs[k] < 0)
+            continue;
+         for (int j = i - 1; j >= 0; j--) {
+            if (ops[j].output_index != (unsigned)inputs[k])
+               continue;
+            for (unsigned c = 0; c < 2; c++) {
+               unsigned lo, hi;
+               if (k == 1) {
+                  lo = r[c][0];
+                  hi = r[c][1];
+               } else {
+                  rkt_mc_in_rows(op, r[c][0], r[c][1], &lo, &hi);
+               }
+               mc_hull(&need[j][c][0], &need[j][c][1], lo, hi);
+            }
+            break;
+         }
+      }
+   }
+
+   free(need);
+}
diff --git a/src/gallium/drivers/rocket/rkt_mc.h b/src/gallium/drivers/rocket/rkt_mc.h
new file mode 100644
index 0000000..dbfe90d
