@@ -982,6 +1028,210 @@ rkt_ml_subgraph_create(struct pipe_context *pcontext,
    return &subgraph->base;
 }
 
+/*
+ * Job batching (ROCKET_BATCH=0 turns it off).
+ *
+ * Every job costs a round trip through the DRM scheduler (fence signal, work
+ * item, run_job, IOMMU attach) of about 50 us on this SoC, as much as an
+ * average task takes on the NPU. Tasks inside one job follow each other
+ * straight from the IRQ handler. So the tasks of consecutive operations go
+ * into ONE job per core, in graph order, and a job is only cut where a task needs the
+ * output of a task on the other core: then the producer's job is closed (it
+ * is pushed first, its fence is what the consumer waits for) and so is the
+ * consumer core's open job, so that the work before the cut does not wait.
+ *
+ * A job reads the tensors it does not write itself and writes the ones it
+ * does. A two-core layer (rkt_mc.c) fences its core 0 half on its mc_sync BO,
+ * so its two halves never wait for each other through the output BO.
+ */
+struct rkt_bjob {
+   unsigned core;
+   struct util_dynarray tasks; /* struct drm_rocket_task */
+   struct util_dynarray in;    /* uint32_t handles */
+   struct util_dynarray out;   /* uint32_t handles */
+};
+
+static void
+rkt_handle_add(struct util_dynarray *set, uint32_t h)
+{
+   util_dynarray_foreach (set, uint32_t, x)
+      if (*x == h)
+         return;
+   util_dynarray_append(set, uint32_t, h);
+}
+
+static bool
+rkt_handle_has(struct util_dynarray *set, uint32_t h)
+{
+   util_dynarray_foreach (set, uint32_t, x)
+      if (*x == h)
+         return true;
+   return false;
+}
