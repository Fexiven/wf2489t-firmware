diff --git a/src/gallium/drivers/rocket/rkt_ml.h b/src/gallium/drivers/rocket/rkt_ml.h
index 81baf9b..dd62a25 100644
--- a/src/gallium/drivers/rocket/rkt_ml.h
+++ b/src/gallium/drivers/rocket/rkt_ml.h
@@ -128,6 +128,8 @@ struct rkt_operation {
    bool c_q14;
    /* Lowered from signed int8 tensors through rkt_int8_view(). */
    bool int8;
+   /* the activation input is a signed int8 tensor (int8 on) */
+   bool in_signed;
    bool depthwise;
    bool reuse_weights_cbuf;
    unsigned truncate_bits;
@@ -253,13 +255,73 @@ rkt_fc_width(unsigned input_width)
  * The register that differs besides the encoding is 0x1064, which the
  * vendor runtime sets at load time: 0x7 in mode 2, 0x777 in mode 6.
  */
+/*
+ * The vendor's first-conv modes for any 1 or 3 channel input
+ * (rknn-toolkit2 2.3.2 rk3576, 30 compiled int8 layers + the runtime captures
+ * of yolox 001, micronet 000 and movenet lightning 005):
+ *
+ *   ic 3: mode 6 when output_width % 16 == 0, else mode 2, for every output
+ *         count (12, 16, 24, 56, 64, 276 seen), kernel (3, 5, 7) and stride
+ *         (1, 2), SAME or VALID.
+ *   ic 1: always mode 2 with 0x100c bit 13 clear (0x20008002), even at
+ *         ow % 16 == 0 (micronet's 32x32x1 -> 276, 3x3 s1).
+ *
+ * The CNA side counts the output channels padded to 16 (0x101c, 0x1024 low;
+ * yolox's 12 -> 16, micronet's 276 -> 288, movenet thunder's 56 -> 64), the
+ * CORE/DPU/RDMA side the real count. The weights come in groups of 32 output
+ * channels (the last one holding the rest of the padded count), in both modes.
+ *
+ * These layers must not go through the generic encoder: its CNA would be
+ * told a generic weight size while the first-conv input and weight buffers
+ * are much shorter, and the DMA would run past them.
+ */
+
+/*
+ * A signed int8 input of a first conv goes to the NPU as the raw int8 bytes
+ * with the CNA CVT bypassed (0x1048 = 9, 0x104c = 0x1050 = 0x00010001, lane
+ * offsets 0) and 0x1070 = zp * 0x010101, as librknnrt programs it for every
+ * int8 first conv. Offset uint8 through CVT -128 is only right at aligned
+ * widths.
+ *
+ * A per-tensor int8 first conv uses the vendor's plain int32 bias mode (RDMA
+ * 0x501c = 0x114, DPU 0x4044 = 0, 0x4050 = 0x80021011, OUT_CVT shift without
+ * the +4 of the A/B/C records with C = 16). The int32 values are the A of the
+ * records, written as a plain array at rkt_fc_pt114_off() inside the bias
+ * buffer. uint8 first convs keep the records.
+ */
+static inline bool
+rkt_fc_pt114(bool int8)
+{
+   return int8;
+}
+
+static inline unsigned
+rkt_fc_pt114_off(unsigned table_bytes)
+{
+   return table_bytes + 0x100;
+}
+
+static inline bool
+rkt_fc_any_shape(unsigned ic, unsigned kw, unsigned kh, unsigned stride,
+                 bool depthwise)
+{
+   return !depthwise && (ic == 1 || ic == 3) && kw == kh &&
+          (kw == 3 || kw == 5 || kw == 7) && (stride == 1 || stride == 2);
+}
+
+/* the output channel count the CNA and the first-conv weight buffer use */
+static inline unsigned
+rkt_fc_oc_pad(unsigned oc)
+{
+   return align(oc, 16);
+}
+
 static inline bool
 rkt_fc_mode2_shape(unsigned ic, unsigned oc, unsigned kw, unsigned kh,
                    unsigned stride, unsigned ow, bool depthwise)
 {
-   if (depthwise || ic != 3 || oc != 32 || kw != 3 || kh != 3 || stride != 2)
-      return false;
-   return ow % 16 != 0;
+   return rkt_fc_any_shape(ic, kw, kh, stride, depthwise) &&
+          (ic == 1 || ow % 16 != 0);
 }
 
 static inline bool
@@ -276,16 +338,32 @@ rkt_fc_mode2(const struct rkt_operation *operation)
 /*
  * CBUF entries one first-conv input row takes (0x103c high, 0x1044 low in
  * mode 6, 0x1028 high / span, the window rule in rkt_task.c). Mode 2:
- * ALIGN(w, 16) / 16. Mode 6: DIV_ROUND_UP(w, 16) + 1 (15 at 224, 21 at 320).
+ * ALIGN(w, 16) / 16. Mode 6, over 46 compiled widths (8 to 418, SAME and
+ * VALID, stride 1 and 2):
+ *
+ *   0x118c high = (w + pad_right) / 16, 0x118c low = (w - 1) / 16,
+ *   eps (0x103c, 0x1044 low, 0x1028 high / span) = 0x118c high + 1
  */
 static inline unsigned
-rkt_fc_eps(const struct rkt_operation *operation)
+rkt_fc_m6_hi(unsigned w, unsigned pad_right)
+{
+   return (w + pad_right) / 16;
+}
+
+static inline unsigned
+rkt_fc_m6_lo(unsigned w, unsigned pad_right)
+{
+   return (w - 1) / 16;
+}
+
+static inline unsigned
+rkt_fc_eps(const struct rkt_operation *operation, unsigned pad_right)
 {
    unsigned w = operation->input_width;
 
    if (rkt_fc_mode2(operation))
       return align(w, 16) / 16;
-   return DIV_ROUND_UP(w, 16) + 1;
+   return rkt_fc_m6_hi(w, pad_right) + 1;
 }
 
