diff --git a/src/gallium/drivers/rocket/rkt_coefs.c b/src/gallium/drivers/rocket/rkt_coefs.c
index 1a47a9b..384b757 100644
--- a/src/gallium/drivers/rocket/rkt_coefs.c
+++ b/src/gallium/drivers/rocket/rkt_coefs.c
@@ -132,6 +132,17 @@ rkt_fill_weights(struct rkt_ml_subgraph *subgraph,
                                       poperation->conv.stride_x,
                                       poperation->output_tensors[0]->dims[1],
                                       false);
+   /*
+    * a layer in the vendor's first-conv modes (rkt_fc_any_shape)
+    * has its output channels padded to 16 in the weight buffer, in groups of
+    * 32 (both modes); see the packing below.
+    */
+   bool fc_any = is_rk3576_firstconv &&
+                 rkt_fc_any_shape(input_channels_real, weights_width,
+                                  weights_height, poperation->conv.stride_x,
+                                  false);
+   unsigned fc_ocp = fc_any ? rkt_fc_oc_pad(output_channels_real)
+                            : output_channels_real;
 
    /*
     * RK3576 pointwise (1x1) conv uses a compact [oc][ic] weight buffer of
@@ -167,11 +178,11 @@ rkt_fill_weights(struct rkt_ml_subgraph *subgraph,
                               weights_width == 1 && weights_height == 1;
 
    if (fc_mode2)
-      weights_size = weights_width * weights_height * output_channels_real * 4;
+      weights_size = weights_width * weights_height * fc_ocp * 4;
    else if (is_rk3576_firstconv)
       /* kh * ALIGN(kw, 4) lanes of 4 per output channel */
       weights_size = weights_height * ALIGN(weights_width, 4) *
-                     output_channels_real * 4;
+                     fc_ocp * 4;
    else if (is_rk3576_pointwise)
       /*
        * PADDED TO THE FEATURE ATOM, not cut at the real channel count. The CNA
@@ -386,11 +397,29 @@ rkt_fill_weights(struct rkt_ml_subgraph *subgraph,
        * tap major, then output channel, then the four ARGB lanes; no unused
        * fourth kx slot as mode 6 has.
        */
+      /*
+       * both modes come in groups of 32 output channels over the
+       * count padded to 16 (rknn-toolkit2 2.3.2 buffers of the compiled
+       * 12/16/24/56/64 output layers, and the runtime capture of micronet's
+       * 276 -> 288 one-channel layer: 10368 of 10368 bytes):
+       *
+       *   mode 2: [oc / 32][ky][kx][oc % 32][4 lanes]
+       *   mode 6: [oc / 32][ky][oc % 32][ALIGN(kw, 4) kx slots][4 lanes]
+       *
+       * the last group holding ocp - 32 * (oc / 32) channels. At 32 outputs
+       * mode 2 is the old [ky][kx][oc][4]. The padded channels keep pad.
+       * One input channel fills lane 0; lanes 1..3 keep pad.
+       */
       if (fc_mode2) {
+         unsigned taps = weights_width * weights_height;
          for (int ky = 0; ky < weights_width; ky++)
             for (int kx = 0; kx < weights_height; kx++)
                for (unsigned oc = 0; oc < oc_n; oc++) {
-                  unsigned base = ((ky * weights_height + kx) * oc_n + oc) * 4;
+                  unsigned g0 = fc_any ? oc / 32 * 32 : 0;
+                  unsigned gn = fc_any ? MIN2(32, fc_ocp - g0) : oc_n;
+                  unsigned base = (g0 * taps +
+                                   (ky * weights_height + kx) * gn +
+                                   (oc - g0)) * 4;
 
                   for (unsigned ic = 0; ic < 3; ic++)
                      weights_out[base + ic] =
@@ -413,7 +442,7 @@ rkt_fill_weights(struct rkt_ml_subgraph *subgraph,
       for (int ky = 0; ky < weights_width; ky++) {
          for (unsigned oc = 0; oc < oc_n; oc++) {
             for (int kx = 0; kx < weights_height; kx++) {
-               unsigned grp = MIN2(32, oc_n - (oc / 32) * 32);
+               unsigned grp = MIN2(32, fc_ocp - (oc / 32) * 32);
                unsigned base = (oc / 32) * 32 * weights_width * slots * 4 +
                                ky * grp * slots * 4 + (oc % 32) * slots * 4 + kx * 4;
 
diff --git a/src/gallium/drivers/rocket/rkt_int8.c b/src/gallium/drivers/rocket/rkt_int8.c
index d3e9fdc..ebd0031 100644
--- a/src/gallium/drivers/rocket/rkt_int8.c
+++ b/src/gallium/drivers/rocket/rkt_int8.c
@@ -162,14 +162,18 @@ rkt_int8_fix_coefs(struct pipe_context *pcontext,
    bool firstconv = rkt_rk3576_firstconv(operation);
    bool op2_fix = operation->int8 && !operation->c_q14 && !firstconv &&
                   operation->input_channels <= 4 && !operation->depthwise;
-   if (!operation->c_q14 && !op2_fix)
+   bool pt114 = firstconv && !operation->c_q14 && !operation->depthwise &&
+                rkt_fc_pt114(operation->int8);
+   if (!operation->c_q14 && !op2_fix && !pt114)
       return;
 
    bool dw = operation->depthwise;
    unsigned oc_n = operation->output_channels;
    unsigned table_bytes = rkt_coef_table_bytes(dw, oc_n);
+   /* where the first-conv encoder points 0x5024: past the oc-sized table
+    * (0x100 at 32 outputs) */
    unsigned op2_off = firstconv
-                         ? 0x100
+                         ? table_bytes
                          : table_bytes + (getenv("ROCKET_SCALE_OFF")
                                              ? 0 : rkt_scale_table_bytes(oc_n));
    unsigned size = pipe_buffer_size(operation->biases);
@@ -177,6 +181,13 @@ rkt_int8_fix_coefs(struct pipe_context *pcontext,
    uint8_t *b8 = pipe_buffer_map(pcontext, operation->biases, PIPE_MAP_WRITE,
                                  &transfer);
 
+   /* plain int32 bias array for the 0x114 mode, see rkt_fc_pt114() */
+   if (pt114) {
+      unsigned off = rkt_fc_pt114_off(table_bytes);
+      for (unsigned oc = 0; oc < oc_n && off + 4 * (oc + 1) <= size; oc++)
+         memcpy(b8 + off + 4 * oc, b8 + (oc / 8) * 64 + (oc % 8) * 4, 4);
+   }
+
    if (operation->c_q14) {
       const float *wsc = poperation->conv.weight_tensor->scales;
       float max = 0.0f;
@@ -222,7 +233,11 @@ rkt_int8_fix_coefs(struct pipe_context *pcontext,
 bool
 rkt_int8_raw_input(const struct rkt_operation *operation)
 {
-   return operation->soc == RKT_SOC_RK3576 && !operation->depthwise &&
-          operation->input_channels <= 4 &&
-          !rkt_rk3576_firstconv(operation);
+   if (operation->soc != RKT_SOC_RK3576 || operation->depthwise ||
+       operation->input_channels > 4)
+      return false;
+   /* the first conv takes raw int8 too, see rkt_fc_pt114() */
+   if (rkt_rk3576_firstconv(operation))
+      return operation->in_signed;
+   return true;
 }
