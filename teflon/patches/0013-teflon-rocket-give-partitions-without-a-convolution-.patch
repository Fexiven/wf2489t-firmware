+    * tensor is produced and consumed). NULL keeps every operation that
+    * ml_operation_supported accepted.
+    *
+    * The frontend groups the operations that stay supported into subgraphs
+    * the way TensorFlow Lite partitions a graph: greedily, in execution
+    * order, each subgraph taking every supported operation whose inputs
+    * are ready.
+    *
+    * \param ctx         pipe context
+    * \param operations  every operation of the graph, in execution order;
+    *                    of an unsupported one only the input and output
+    *                    tensors are meaningful
+    * \param count       number of operations
+    * \param supported   per operation, the result of ml_operation_supported;
+    *                    the driver may clear entries, never set them
+    */
+   void (*ml_operations_filter)(struct pipe_context *context,
+                                const struct pipe_ml_operation *operations,
+                                unsigned count, bool *supported);
+
