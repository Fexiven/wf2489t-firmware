@@ -798,6 +798,148 @@ rkt_ml_operation_supported(struct pipe_context *pcontext,
    return supported;
 }
 
+/*
+ * The graph as rkt_ml_operations_filter() sees it: the producer of every
+ * operation input, and the partitions Teflon (TFLite) will group the
+ * supported operations into.
+ */
+struct rkt_ml_graph {
+   const struct pipe_ml_operation *ops;
+   unsigned count;
+   /* producer[i][j]: the operation writing input j of operation i, or -1 */
+   int **producer;
+   /* per operation, its partition, or -1 */
+   int *partition;
+};
+
+static void
+rkt_ml_graph_init(struct rkt_ml_graph *g, const struct pipe_ml_operation *ops,
+                  unsigned count)
+{
+   g->ops = ops;
+   g->count = count;
+   g->producer = calloc(count, sizeof(*g->producer));
+   g->partition = calloc(count, sizeof(*g->partition));
+
+   for (unsigned i = 0; i < count; i++) {
+      g->producer[i] = malloc(MAX2(ops[i].input_count, 1) * sizeof(int));
+      for (unsigned j = 0; j < ops[i].input_count; j++) {
+         g->producer[i][j] = -1;
+         /* compare the pointers only: unused inputs may not be valid tensors */
+         for (unsigned k = 0; k < count && g->producer[i][j] < 0; k++)
+            for (unsigned l = 0; l < ops[k].output_count; l++)
+               if (ops[k].output_tensors[l] == ops[i].input_tensors[j])
+                  g->producer[i][j] = k;
+      }
+   }
+}
+
+static void
+rkt_ml_graph_fini(struct rkt_ml_graph *g)
+{
+   for (unsigned i = 0; i < g->count; i++)
+      free(g->producer[i]);
+   free(g->producer);
+   free(g->partition);
+}
+
+/*
+ * Group the operations like TFLite's PartitionGraphIntoIndependentNodeSubsets:
+ * each partition takes, in execution order and until nothing changes, every
+ * operation of its kind (supported or not) whose inputs are ready.
+ */
+static void
+rkt_ml_graph_partition(struct rkt_ml_graph *g, const bool *supported)
+{
+   int n = g->count, partition = 0;
+
+   for (int i = 0; i < n; i++)
+      g->partition[i] = -1;
+
+   for (;;) {
+      int type = -1, added = 0;
+      bool progress = true;
+
+      while (progress) {
+         progress = false;
+         for (int i = 0; i < n; i++) {
+            bool ready = true;
+
+            if (g->partition[i] >= 0)
+               continue;
+            for (unsigned j = 0; j < g->ops[i].input_count; j++) {
+               int p = g->producer[i][j];
+               if (p >= 0 && g->partition[p] < 0)
+                  ready = false;
+            }
+            if (!ready)
+               continue;
+            if (type < 0)
+               type = supported[i];
+            if (supported[i] != type)
+               continue;
+            g->partition[i] = partition;
+            added++;
+            progress = true;
+         }
+      }
+      if (!added || partition >= n)
+         break;
+      partition++;
+   }
+}
+
+/*
+ * A partition without a convolution (a lone ADD in the CPU post-processing
+ * of MoveNet or YOLOX) costs an NPU round trip -- submit, wait and two
+ * layout conversions -- for an operation the CPU does in microseconds.
+ * Give its operations back. Returns true if an operation was given back.
+ */
+static bool
+drop_partitions_without_convolution(struct rkt_ml_graph *g, bool *supported)
+{
+   bool *has_conv = calloc(g->count + 1, sizeof(bool));
+   bool changed = false;
+
+   rkt_ml_graph_partition(g, supported);
+
+   for (unsigned i = 0; i < g->count; i++) {
+      if (supported[i] && g->partition[i] >= 0 &&
+          (g->ops[i].type == PIPE_ML_OPERATION_TYPE_CONVOLUTION ||
+           g->ops[i].type == PIPE_ML_OPERATION_TYPE_FULLY_CONNECTED))
+         has_conv[g->partition[i]] = true;
+   }
+   for (unsigned i = 0; i < g->count; i++) {
+      if (supported[i] && g->partition[i] >= 0 && !has_conv[g->partition[i]]) {
+         supported[i] = false;
+         changed = true;
+      }
+   }
+
+   free(has_conv);
+   return changed;
+}
+
+/*
+ * RK3576 (rkt_create_context): graph-level rules on top of
+ * rkt_ml_operation_supported(). Giving an operation back changes the
+ * partitions, so repeat until nothing changes.
+ */
+void
+rkt_ml_operations_filter(struct pipe_context *pcontext,
+                         const struct pipe_ml_operation *operations,
+                         unsigned count, bool *supported)
+{
+   struct rkt_ml_graph g;
+
+   rkt_ml_graph_init(&g, operations, count);
+   for (int pass = 0; pass < 8; pass++) {
+      if (!drop_partitions_without_convolution(&g, supported))
+         break;
+   }
+   rkt_ml_graph_fini(&g);
+}
+
 struct pipe_ml_subgraph *
 rkt_ml_subgraph_create(struct pipe_context *pcontext,
                        const struct pipe_ml_operation *poperations,
