    return supported;
 }
 
+/*
+ * Let the driver give operations back after looking at the whole graph
+ * (pipe_context::ml_operations_filter).
+ */
+static void
+filter_operations(struct teflon_delegate *delegate, TfLiteContext *tf_context,
+                  TfLiteIntArray *plan, bool *supported)
+{
+   struct pipe_context *context = delegate->context;
+   struct pipe_ml_operation *operations = calloc(plan->size, sizeof(*operations));
+
+   for (int i = 0; i < plan->size; i++) {
+      TfLiteNode *node;
+      TfLiteRegistration *registration;
+
+      tf_context->GetNodeAndRegistration(tf_context, plan->data[i], &node, &registration);
+      fill_operation(delegate, tf_context, node, registration, &operations[i]);
+   }
+
+   context->ml_operations_filter(context, operations, plan->size, supported);
+
+   for (int i = 0; i < plan->size; i++)
+      free_operation(&operations[i]);
+   free(operations);
+}
+
 static TfLiteStatus
 PrepareDelegate(TfLiteContext *tf_context, TfLiteDelegate *tf_delegate)
 {
@@ -779,6 +805,7 @@ PrepareDelegate(TfLiteContext *tf_context, TfLiteDelegate *tf_delegate)
 
    // Get a list of supported nodes.
    TfLiteIntArray *supported_nodes = malloc(plan->size * sizeof(int) + sizeof(*supported_nodes));
+   bool *node_supported = calloc(plan->size, sizeof(bool));
    supported_nodes->size = plan->size;
    unsigned node_count = 0;
    for (int i = 0; i < plan->size; i++) {
@@ -825,9 +852,17 @@ PrepareDelegate(TfLiteContext *tf_context, TfLiteDelegate *tf_delegate)
       }
       teflon_debug("\n");
 
-      if (supported)
-         supported_nodes->data[node_count++] = node_index;
+      node_supported[i] = supported;
+   }
+
+   if (delegate->context->ml_operations_filter)
+      filter_operations(delegate, tf_context, plan, node_supported);
+
+   for (int i = 0; i < plan->size; i++) {
+      if (node_supported[i])
+         supported_nodes->data[node_count++] = plan->data[i];
    }
+   free(node_supported);
    supported_nodes->size = node_count;
 
    TfLiteRegistration registration;
