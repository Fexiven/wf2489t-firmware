diff --git a/src/gallium/drivers/rocket/rkt_ovh.h b/src/gallium/drivers/rocket/rkt_ovh.h
new file mode 100644
index 0000000..dab89d4
--- /dev/null
+++ b/src/gallium/drivers/rocket/rkt_ovh.h
@@ -0,0 +1,173 @@
+/*
+ * Copyright (c) 2026 rk3576-npu-open contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * The CPU side of a partition boundary.
+ *
+ * NHWC <-> NC1HWC2 (16-channel groups, tight planes: pixel p of group u at
+ * (u * pixels + p) * 16) conversion, walked pixel by pixel so the host tensor
+ * is read (input) or written (output) strictly sequentially and every 16-byte
+ * group is one NEON load + XOR + store. A group-major walk would read the
+ * host tensor once per group with a stride of C bytes, about 2x slower on the
+ * Cortex-A72.
+ */
+
+#ifndef RKT_OVH_H
+#define RKT_OVH_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "pipe/p_defines.h"
+
+#if defined(__aarch64__)
+#include <arm_neon.h>
+#endif
+
+/*
+ * A subgraph input BO is only read by the NPU and the CPU overwrites it on
+ * every invoke, so mapping it needs neither a fence wait (the previous invoke
+ * has finished by the time its outputs were read) nor the CPU cache
+ * invalidate of PREP_BO, which cost about 0.17 us per KB (yolox: 1 ms an
+ * inference). rkt_buffer_map skips PREP_BO for such maps; the FINI_BO clean
+ * at unmap stays.
+ */
+static inline unsigned
+rkt_ovh_in_map_usage(void)
+{
+   return PIPE_MAP_WRITE | PIPE_MAP_UNSYNCHRONIZED;
+}
+
+/* d[16] = s[0..n) ^ xm, then pad up to 16 */
+static inline void
+rkt_ovh_in_tail(uint8_t *d, const uint8_t *s, unsigned n, uint8_t xm,
+                uint8_t pad)
+{
+   unsigned c = 0;
+   for (; c < n; c++)
+      d[c] = s[c] ^ xm;
+   for (; c < 16; c++)
+      d[c] = pad;
+}
+
+/*
+ * Host NHWC (pixels x channels) -> NPU NC1HWC2, every byte XORed with xm, the
+ * channels past the last real one of the last group set to pad.
+ */
+static inline void
+rkt_ovh_nhwc_to_nc1hwc2(uint8_t *dst, const uint8_t *src, unsigned pixels,
+                        unsigned channels, uint8_t xm, uint8_t pad)
+{
+   const unsigned full = channels / 16, rest = channels % 16;
+   const size_t plane = (size_t)pixels * 16;
+
+#if defined(__aarch64__)
+   const uint8x16_t x = vdupq_n_u8(xm);
+   uint8x16_t tsel = vdupq_n_u8(0), tpad = vdupq_n_u8(pad);
+   if (rest) {
+      uint8_t m[16];
+      for (unsigned c = 0; c < 16; c++)
+         m[c] = c < rest ? 0xff : 0;
+      tsel = vld1q_u8(m);
+   }
+
+   if (full == 4 && !rest) {
+      for (unsigned p = 0; p < pixels; p++) {
+         uint8x16x4_t v = vld1q_u8_x4(src + (size_t)p * 64);
+         uint8_t *d = dst + (size_t)p * 16;
+         vst1q_u8(d, veorq_u8(v.val[0], x));
+         vst1q_u8(d + plane, veorq_u8(v.val[1], x));
+         vst1q_u8(d + 2 * plane, veorq_u8(v.val[2], x));
+         vst1q_u8(d + 3 * plane, veorq_u8(v.val[3], x));
+      }
+      return;
+   }
+   if (full == 2 && !rest) {
+      for (unsigned p = 0; p < pixels; p++) {
+         uint8x16x2_t v = vld1q_u8_x2(src + (size_t)p * 32);
+         uint8_t *d = dst + (size_t)p * 16;
+         vst1q_u8(d, veorq_u8(v.val[0], x));
+         vst1q_u8(d + plane, veorq_u8(v.val[1], x));
+      }
+      return;
+   }
+
+   for (unsigned p = 0; p < pixels; p++) {
+      const uint8_t *s = src + (size_t)p * channels;
+      uint8_t *d = dst + (size_t)p * 16;
+      for (unsigned u = 0; u < full; u++, s += 16, d += plane)
+         vst1q_u8(d, veorq_u8(vld1q_u8(s), x));
+      if (rest) {
+         if (s + 16 <= src + (size_t)pixels * channels) {
+            /* the 16-byte load runs into the next pixel, still in bounds */
+            uint8x16_t v = veorq_u8(vld1q_u8(s), x);
+            vst1q_u8(d, vbslq_u8(tsel, v, tpad));
+         } else {
+            rkt_ovh_in_tail(d, s, rest, xm, pad);
+         }
+      }
+   }
+#else
+   const uint64_t x64 = 0x0101010101010101ull * xm;
+   for (unsigned p = 0; p < pixels; p++) {
+      const uint8_t *s = src + (size_t)p * channels;
+      uint8_t *d = dst + (size_t)p * 16;
+      for (unsigned u = 0; u < full; u++, s += 16, d += plane) {
+         uint64_t a, b;
+         memcpy(&a, s, 8);
+         memcpy(&b, s + 8, 8);
+         a ^= x64;
+         b ^= x64;
+         memcpy(d, &a, 8);
+         memcpy(d + 8, &b, 8);
+      }
+      if (rest)
+         rkt_ovh_in_tail(d, s, rest, xm, pad);
+   }
+#endif
+}
+
+/* NPU NC1HWC2 -> host NHWC (pixels x channels), every byte XORed with xm. */
+static inline void
+rkt_ovh_nc1hwc2_to_nhwc(uint8_t *dst, const uint8_t *src, unsigned pixels,
+                        unsigned channels, uint8_t xm)
+{
+   const unsigned full = channels / 16, rest = channels % 16;
+   const size_t plane = (size_t)pixels * 16;
+
+#if defined(__aarch64__)
+   const uint8x16_t x = vdupq_n_u8(xm);
+   for (unsigned p = 0; p < pixels; p++) {
+      const uint8_t *s = src + (size_t)p * 16;
+      uint8_t *d = dst + (size_t)p * channels;
+      for (unsigned u = 0; u < full; u++, s += plane, d += 16)
+         vst1q_u8(d, veorq_u8(vld1q_u8(s), x));
+      if (rest) {
+         if (d + 16 <= dst + (size_t)pixels * channels) {
+            /*
+             * The 16-byte store runs into the next pixels, which are written
+             * after this one, so the extra bytes are overwritten.
+             */
+            vst1q_u8(d, veorq_u8(vld1q_u8(s), x));
+         } else {
+            for (unsigned c = 0; c < rest; c++)
+               d[c] = s[c] ^ xm;
+         }
+      }
+   }
+#else
+   for (unsigned p = 0; p < pixels; p++) {
+      const uint8_t *s = src + (size_t)p * 16;
+      uint8_t *d = dst + (size_t)p * channels;
+      for (unsigned u = 0; u < full; u++, s += plane, d += 16)
+         for (unsigned c = 0; c < 16; c++)
+            d[c] = s[c] ^ xm;
+      for (unsigned c = 0; c < rest; c++)
+         d[c] = s[c] ^ xm;
+   }
+#endif
+}
+
+#endif
