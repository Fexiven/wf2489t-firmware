 src/gallium/drivers/rocket/rkt_ml.c     | 115 +++++++---------
 src/gallium/drivers/rocket/rkt_ml.h     |   4 +
 src/gallium/drivers/rocket/rkt_ovh.h    | 173 ++++++++++++++++++++++++
 4 files changed, 235 insertions(+), 67 deletions(-)
 create mode 100644 src/gallium/drivers/rocket/rkt_ovh.h

