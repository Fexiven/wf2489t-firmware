@@ -117,8 +117,12 @@ rkt_buffer_map(struct pipe_context *pctx,
    arg.handle = rsc->handle;
    arg.timeout_ns = INT64_MAX;
 
-   ret = drmIoctl(screen->fd, DRM_IOCTL_ROCKET_PREP_BO, &arg);
-   assert(ret != -1);
+   /* write-only unsynchronized maps skip PREP_BO (rkt_ovh.h) */
+   if ((usage & (PIPE_MAP_READ | PIPE_MAP_WRITE | PIPE_MAP_UNSYNCHRONIZED)) !=
+       (PIPE_MAP_WRITE | PIPE_MAP_UNSYNCHRONIZED)) {
+      ret = drmIoctl(screen->fd, DRM_IOCTL_ROCKET_PREP_BO, &arg);
+      assert(ret != -1);
+   }
 
    if (rsc->parent) {
       /* a view: the parent's mapping, moved by the view offset */
@@ -161,7 +165,7 @@ rkt_buffer_unmap(struct pipe_context *pctx,
 
    arg.handle = rsrc->handle;
 
-   if (transfer->usage == PIPE_MAP_WRITE) {
+   if (transfer->usage & PIPE_MAP_WRITE) {
       ret = drmIoctl(screen->fd, DRM_IOCTL_ROCKET_FINI_BO, &arg);
       assert(ret >= 0);
    }
