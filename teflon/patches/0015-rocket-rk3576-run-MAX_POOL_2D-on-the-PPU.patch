diff --git a/src/gallium/drivers/rocket/rkt_ops.h b/src/gallium/drivers/rocket/rkt_ops.h
new file mode 100644
index 0000000..957c92b
--- /dev/null
+++ b/src/gallium/drivers/rocket/rkt_ops.h
@@ -0,0 +1,120 @@
+/*
+ * Copyright (c) 2026 rk3576-npu-open contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * RK3576 non-convolution operations as the vendor compiler (rknn-toolkit2
+ * 2.3.2, target rk3576) emits them:
+ *
+ *   MAX_POOL_2D              one PPU + PPU RDMA task (enable mask 0x60)
+ *
+ * The register values are reproduced from the vendor's .rknn for
+ * maxpool 40/20/10/5 x 64/32/128/24/8 ch, 3x3 s2, 2x2 s2, 5x5 s1, 3x3 s1.
+ * The only deliberate differences: surface strides are Mesa's tight planes
+ * (the vendor rounds every plane up to a multiple of 4 pixels), and the
+ * per-unit OP_ENs Mesa's RK3576 streams end with replace the vendor's PC
+ * descriptor enable mask (as for the EW ADD, rkt_ew.h).
+ *
+ * PPU tasks raise the PPU interrupt, not the DPU one. A rocket kernel driver
+ * that only unmasks and accepts DPU_0/DPU_1 would time out on them, so
+ * MAX_POOL is only claimed when the kernel reports DRM_ROCKET_PARAM_PPU_TASKS.
+ */
+
+#ifndef RKT_OPS_H
+#define RKT_OPS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#include "rkt_ew.h"
+
+#define RKT_OPS_MAX_REGS 112
+
+enum rkt_ops_kind {
+   RKT_OPS_NONE = 0,
+   RKT_OPS_MAXPOOL,
+};
+
+struct rkt_ops_params {
+   enum rkt_ops_kind kind;
+   /* Mesa's width = TFLite dim 1, height = dim 2 (square shapes only) */
+   unsigned in_w, in_h, out_w, out_h;
+   unsigned channels;        /* real channels */
+   unsigned groups;          /* 16-channel groups */
+   /* pool */
+   unsigned kw, kh, sx, sy;
+   unsigned pad_l, pad_t, pad_r, pad_b;
+   uint32_t in_addr, out_addr;
+};
+
+/* the unit OP_EN value every RK3576 task ends with */
+#define RKT_OPS_OPEN 0x1d
+
+/*
+ * MAX_POOL_2D: PPU reading the input through the PPU RDMA. Field layout from
+ * the vendor's streams (RK3588 register names, same offsets on RK3576):
+ *   0x600c/10/14  input  width-1 / height-1 / channels-1 (16-aligned)
+ *   0x6018/1c/20  output width-1 / height-1 / channels-1
+ *   0x6024        0x11: max pooling, input from the PPU RDMA
+ *   0x6034        kernel w-1 [3:0], h-1 [11:8], stride x-1 [19:16], y-1 [23:20]
+ *   0x6040        pad left [3:0], top [7:4], right [11:8], bottom [15:12]
+ *   0x6044..50    pad value -128 (19 bit), the int8-domain minimum
+ *   0x6070/7c/84  output address / surface stride / surface stride
+ *   0x700c/10/14  input cube, 0x701c input address,
+ *   0x7024/28     input line / surface stride, 0x7030 = 0x40
+ */
+static inline unsigned
+rkt_ops_pool_emit(const struct rkt_ops_params *p, uint64_t *out)
+{
+   unsigned n = 0;
+   unsigned c = p->groups * 16;
+   uint32_t in_plane = p->in_w * p->in_h * 16;
+   uint32_t out_plane = p->out_w * p->out_h * 16;
+   uint32_t open = RKT_OPS_OPEN;
+
+#define R_PPU(reg, val)  out[n++] = rkt_ew_word(0x4001, (reg), (uint32_t)(val))
+#define R_PDMA(reg, val) out[n++] = rkt_ew_word(0x8001, (reg), (uint32_t)(val))
+
+   R_PPU(0x6004, 0x0000000e);
+   R_PDMA(0x7004, 0x0000000e);
+   R_PPU(0x600c, p->in_w - 1);
+   R_PPU(0x6010, p->in_h - 1);
+   R_PPU(0x6014, c - 1);
+   R_PPU(0x6018, p->out_w - 1);
+   R_PPU(0x601c, p->out_h - 1);
+   R_PPU(0x6020, c - 1);
+   R_PPU(0x6024, 0x00000011);
+   R_PPU(0x6034, ((p->sy - 1) << 20) | ((p->sx - 1) << 16) |
+                 ((p->kh - 1) << 8) | (p->kw - 1));
+   R_PPU(0x6038, 0x00000000);
+   R_PPU(0x603c, 0x00000000);
+   R_PPU(0x6040, (p->pad_b << 12) | (p->pad_r << 8) | (p->pad_t << 4) |
+                 p->pad_l);
+   R_PPU(0x6044, 0x0007ff80);
+   R_PPU(0x6048, 0x0007ff80);
+   R_PPU(0x604c, 0x0007ff80);
+   R_PPU(0x6050, 0x0007ff80);
+   R_PPU(0x6054, 0x00000000);
+   R_PPU(0x6058, 0x00000000);
+   R_PPU(0x605c, 0x00000000);
+   R_PPU(0x6070, p->out_addr);
+   R_PPU(0x607c, out_plane);
+   R_PPU(0x6084, out_plane);
+   R_PPU(0x60dc, 0x00000000);
+   R_PDMA(0x700c, p->in_w - 1);
+   R_PDMA(0x7010, p->in_h - 1);
+   R_PDMA(0x7014, c - 1);
+   R_PDMA(0x701c, p->in_addr);
+   R_PDMA(0x7024, p->in_w * 16);
+   R_PDMA(0x7028, in_plane);
+   R_PDMA(0x7030, 0x00000040);
+
+   R_PPU(0x6008, open);
+   R_PDMA(0x7008, open);
+
+#undef R_PPU
+#undef R_PDMA
+   return n;
+}
+
+#endif /* RKT_OPS_H */
