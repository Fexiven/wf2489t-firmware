+/*
+ * the input and output of a pool / resize: per-tensor quantization,
+ * identical scale and zero point (TFLite requires it for int8 MAX_POOL_2D and
+ * RESIZE_NEAREST_NEIGHBOR; the NPU copies values without requantizing), same
+ * signedness, batch 1, square, more than 4 channels (<= 4 would take the
+ * first-convolution input path in invoke).
+ */
+static bool
+rkt_ops_io_ok(const struct pipe_ml_operation *operation)
+{
+   struct pipe_tensor *i = operation->input_tensors[0];
+   struct pipe_tensor *o = operation->output_tensors[0];
+
+   if (operation->output_count != 1 || i->resource != NULL)
+      return false;
+   if (!tensor_quantization_supported(i) || !tensor_quantization_supported(o))
+      return false;
+   if (i->scale != o->scale || i->zero_point != o->zero_point ||
+       i->is_signed != o->is_signed)
+      return false;
+   if (i->dims[0] != 1 || o->dims[0] != 1 || i->dims[3] != o->dims[3] ||
+       i->dims[3] <= 4)
+      return false;
+   if (i->dims[1] != i->dims[2] || o->dims[1] != o->dims[2])
+      return false;
+   return true;
+}
+
+/* TFLite SAME / VALID geometry of one pooling dimension */
+static bool
+rkt_ops_pool_dim(unsigned in, unsigned out, unsigned k, unsigned s, bool same,
+                 unsigned *before, unsigned *after)
+{
+   unsigned o = same ? DIV_ROUND_UP(in, s) : (in >= k ? (in - k) / s + 1 : 0);
+   if (o != out)
+      return false;
+   int total = same ? (int)((o - 1) * s + k) - (int)in : 0;
+   if (total < 0)
+      total = 0;
+   *before = total / 2;
+   *after = total - total / 2;
+   return true;
+}
+
+static bool
+rkt_ops_pool_supported(struct rkt_screen *screen,
+                       const struct pipe_ml_operation *operation)
+{
+   struct pipe_tensor *i = operation->input_tensors[0];
+   struct pipe_tensor *o = operation->output_tensors[0];
+   unsigned k = operation->pooling.filter_width;
+   unsigned s = operation->pooling.stride_x;
+   unsigned b, a;
+
+   /* MAX_POOL on the PPU needs a kernel that completes PPU tasks */
+   if (!screen->ppu_tasks || !rkt_ops_io_ok(operation))
+      return false;
+   if (operation->pooling.type != PIPE_ML_POOLING_TYPE_MAX)
+      return false;
+   if (k != operation->pooling.filter_height || s != operation->pooling.stride_y)
+      return false;
+   /* the vendor runs <= 5x5 as one PPU task and cascades bigger kernels */
+   if (k < 1 || k > 5 || s < 1 || s > 8)
+      return false;
+   if (!rkt_ops_pool_dim(i->dims[1], o->dims[1], k, s,
+                         operation->pooling.padding_same, &b, &a) || b > 7 || a > 7)
+      return false;
+   /* the vendor splits stride-1 pools wider than 28 (seen at 48) into column
+    * windows, stride-2 pools stay one task up to 112 */
+   if (i->dims[2] > (s == 1 ? 28u : 112u))
+      return false;
+   return true;
+}
+
+static void
+lower_ops_rk3576(struct rkt_ml_subgraph *subgraph,
+                 const struct pipe_ml_operation *poperation,
+                 struct rkt_operation *operation)
+{
+   struct pipe_context *pcontext = subgraph->base.context;
+   struct rkt_screen *screen = rkt_screen(pcontext->screen);
+   const struct pipe_tensor *i = poperation->input_tensors[0];
+   const struct pipe_tensor *o = poperation->output_tensors[0];
+   struct rkt_ops_params *p = &operation->ops;
+
+   util_dynarray_init(&operation->tasks, NULL);
+   operation->soc = screen->soc;
+   operation->cbuf_banks = screen->cbuf_banks;
+   operation->cbuf_entries_per_bank = screen->cbuf_entries_per_bank;
+   operation->cbuf_bank_size = screen->cbuf_bank_size;
+
+   operation->input_index = i->index;
+   operation->input_width = i->dims[1];
+   operation->input_height = i->dims[2];
+   operation->input_channels = i->dims[3];
+   operation->input_zero_point = rkt_ew_zp(i) + 0x80;
+   operation->input_scale = i->scale;
+
+   operation->output_index = o->index;
+   operation->output_width = o->dims[1];
+   operation->output_height = o->dims[2];
+   operation->output_channels = o->dims[3];
+   operation->output_zero_point = rkt_ew_zp(o) + 0x80;
+   operation->output_scale = o->scale;
+
+   memset(p, 0, sizeof(*p));
+   p->in_w = i->dims[1];
+   p->in_h = i->dims[2];
+   p->out_w = o->dims[1];
+   p->out_h = o->dims[2];
+   p->channels = i->dims[3];
+   p->groups = DIV_ROUND_UP(i->dims[3], FEATURE_ATOMIC_SIZE);
+
+   if (poperation->type == PIPE_ML_OPERATION_TYPE_POOLING) {
+      p->kind = RKT_OPS_MAXPOOL;
+      p->kw = poperation->pooling.filter_width;
+      p->kh = poperation->pooling.filter_height;
+      p->sx = poperation->pooling.stride_x;
+      p->sy = poperation->pooling.stride_y;
+      rkt_ops_pool_dim(p->in_w, p->out_w, p->kw, p->sx,
+                       poperation->pooling.padding_same, &p->pad_l, &p->pad_r);
+      rkt_ops_pool_dim(p->in_h, p->out_h, p->kh, p->sy,
+                       poperation->pooling.padding_same, &p->pad_t, &p->pad_b);
+   }
+}
+
 /*
  * Rocket applies no activation fused into an ADD, pooling or concatenation.
  * Such an operation is still correct when the output's quantized range
@@ -791,6 +919,11 @@ rkt_ml_operation_supported(struct pipe_context *pcontext,
       supported = operation->input_tensors[0]->resource == NULL &&
                   operation->input_tensors[1]->resource == NULL;
       break;
+   case PIPE_ML_OPERATION_TYPE_POOLING:
+      supported = rkt_screen(pcontext->screen)->soc == RKT_SOC_RK3576 &&
+                  rkt_ops_pool_supported(rkt_screen(pcontext->screen),
+                                         operation);
+      break;
    default:
       supported = false;
    }
@@ -1089,6 +1222,12 @@ rkt_ml_subgraph_create(struct pipe_context *pcontext,
 
          break;
       }
+      case PIPE_ML_OPERATION_TYPE_POOLING:
+         /* rkt_ops.h */
+         lower_ops_rk3576(subgraph, &poperations[i], &operation);
+         util_dynarray_append(&subgraph->operations, struct rkt_operation,
+                              operation);
+         break;
       default:
          DBG("poperation->type %d\n", poperations[i].type);
          UNREACHABLE("Unsupported ML operation type");
@@ -1184,6 +1323,14 @@ rkt_ml_subgraph_create(struct pipe_context *pcontext,
          task.output_channels = operation->output_channels;
          task.output_channels_real = operation->output_channels;
          util_dynarray_append(&operation->tasks, struct split_task, task);
+      } else if (operation->ops.kind != RKT_OPS_NONE) {
+         /* PPU pool = one task */
+         struct split_task task = {0};
+         task.output_width = operation->output_width;
+         task.output_height = operation->output_height;
+         task.output_channels = operation->output_channels;
+         task.output_channels_real = operation->output_channels;
+         util_dynarray_append(&operation->tasks, struct split_task, task);
       } else
          rkt_split_tasks(subgraph, operation);
       compile_operation(subgraph, operation);
