+static void
+lower_concat_rk3576(struct rkt_ml_subgraph *subgraph,
+                    const struct pipe_ml_operation *poperation,
+                    struct rkt_operation *operation)
+{
+   struct rkt_screen *screen = rkt_screen(subgraph->base.context->screen);
+   const struct pipe_tensor *o = poperation->output_tensors[0];
+   unsigned n = poperation->input_count;
+
+   util_dynarray_init(&operation->tasks, NULL);
+   operation->soc = screen->soc;
+   operation->cbuf_banks = screen->cbuf_banks;
+   operation->cbuf_entries_per_bank = screen->cbuf_entries_per_bank;
+   operation->cbuf_bank_size = screen->cbuf_bank_size;
+   operation->ops.kind = RKT_OPS_CONCAT;
+
+   operation->output_index = o->index;
+   operation->output_width = o->dims[1];
+   operation->output_height = o->dims[2];
+   operation->output_channels = o->dims[3];
+   operation->output_zero_point = rkt_ew_zp(o) + 0x80;
+   operation->output_scale = o->scale;
+
+   operation->concat_n = n;
+   operation->concat_in = calloc(n, sizeof(unsigned));
+   operation->concat_c = calloc(n, sizeof(unsigned));
+   operation->concat_shadow = calloc(n, sizeof(struct rkt_operation));
+   for (unsigned k = 0; k < n; k++) {
+      const struct pipe_tensor *i = poperation->input_tensors[k];
+      struct rkt_operation *sh = &operation->concat_shadow[k];
+
+      operation->concat_in[k] = i->index;
+      operation->concat_c[k] = i->dims[3];
+
+      /* invoke's view of input k: an operation reading just that tensor */
+      sh->soc = screen->soc;
+      sh->add_tensor = -1;
+      sh->ops.kind = RKT_OPS_CONCAT;
+      sh->input_index = i->index;
+      sh->input_width = i->dims[1];
+      sh->input_height = i->dims[2];
+      sh->input_channels = i->dims[3];
+      sh->input_zero_point = rkt_ew_zp(i) + 0x80;
+      sh->input_scale = i->scale;
+      sh->output_index = o->index;
+      sh->output_width = i->dims[1];
+      sh->output_height = i->dims[2];
+      sh->output_channels = i->dims[3];
+      sh->output_zero_point = sh->input_zero_point;
+      sh->output_scale = i->scale;
+   }
+   /* the operation itself reads input 0, like its shadow */
+   operation->add_tensor = -1;
+   operation->input_index = operation->concat_shadow[0].input_index;
+   operation->input_width = operation->concat_shadow[0].input_width;
+   operation->input_height = operation->concat_shadow[0].input_height;
+   operation->input_channels = operation->concat_shadow[0].input_channels;
+   operation->input_zero_point = operation->concat_shadow[0].input_zero_point;
+   operation->input_scale = operation->concat_shadow[0].input_scale;
+}
+
+/*
+ * make the inputs of every CONCATENATION views of its output, the
+ * last concatenation first, so that a concat feeding another one is itself a
+ * view of the outer output already when its inputs are placed. Returns false
+ * if an input already has a buffer (Teflon should have refused the concat).
+ */
+static bool
+place_concat_views(struct rkt_ml_subgraph *subgraph)
+{
+   unsigned n = util_dynarray_num_elements(&subgraph->operations,
+                                           struct rkt_operation);
+   struct rkt_operation *ops = util_dynarray_begin(&subgraph->operations);
+   struct pipe_resource **tensors = util_dynarray_begin(&subgraph->tensors);
+
+   for (int i = (int)n - 1; i >= 0; i--) {
+      struct rkt_operation *op = &ops[i];
+      unsigned plane, c0 = 0;
+
+      if (op->ops.kind != RKT_OPS_CONCAT)
+         continue;
+      if (!tensors[op->output_index])
+         create_tensor(subgraph, op->output_index, calc_raw_output_size(op));
+      plane = op->output_width * op->output_height * FEATURE_ATOMIC_SIZE;
+      for (unsigned k = 0; k < op->concat_n; k++) {
+         unsigned idx = op->concat_in[k];
+         unsigned off = c0 / FEATURE_ATOMIC_SIZE * plane;
+         struct pipe_resource *parent = tensors[op->output_index];
+
+         if (tensors[idx] || c0 % FEATURE_ATOMIC_SIZE) {
+            fprintf(stderr, "rocket: CONCAT -> t%u: input t%u cannot be "
+                    "placed in the output\n", op->output_index, idx);
+            return false;
+         }
+         tensors[idx] = rkt_resource_view(parent, off, parent->width0 - off);
+         c0 += op->concat_c[k];
+      }
+   }
+   return true;
+}
+
+/*
+ * the operations that write the tensor: its producer, or for a
+ * concatenation output the producers of its inputs (recursively). A
+ * subgraph input has none.
+ */
+static unsigned
+real_producers(struct rkt_ml_subgraph *subgraph, unsigned idx,
+               struct rkt_operation **out, unsigned max)
+{
+   struct rkt_operation *p = find_producer(subgraph, idx);
+   unsigned n = 0;
+
+   if (!p)
+      return 0;
+   if (p->ops.kind != RKT_OPS_CONCAT) {
+      out[0] = p;
+      return 1;
+   }
+   for (unsigned k = 0; k < p->concat_n && n < max; k++)
+      n += real_producers(subgraph, p->concat_in[k], out + n, max - n);
+   return n;
+}
+
+/*
+ * CONCATENATION along the channels, zero copy. In NC1HWC2 an input
+ * that starts at a channel offset c0 with c0 % 16 == 0 is the byte range
+ * [c0 / 16 * plane, ...) of the output (plane = W * H * 16), so it becomes a
+ * view of the output BO and its producer writes straight into the concat.
+ * Conditions: per-tensor quantization identical on all inputs and the output
+ * (no requantization), same batch / spatial size, every input except the
+ * last a multiple of 16 channels, more than 4 channels everywhere (<= 4 is
+ * the first-convolution input path). rkt_ml_operations_filter() makes sure
+ * that no tensor is an input of two claimed concatenations. Tensors of lower
+ * rank come with leading dimensions of 1, so axis 3 / -1 is their last axis.
+ */
+static bool
+rkt_concat_supported(const struct pipe_ml_operation *operation)
+{
+   struct pipe_tensor *o = operation->output_tensors[0];
+   unsigned c = 0;
+
+   if (operation->output_count != 1 ||
+       operation->input_count < 2 || operation->input_count > 16 ||
+       !(operation->conc.axis == 3 || operation->conc.axis == -1))
+      return false;
+   if (!tensor_quantization_supported(o) || o->dims[0] != 1 || o->dims[3] <= 4)
+      return false;
+   for (unsigned k = 0; k < operation->input_count; k++) {
+      struct pipe_tensor *i = operation->input_tensors[k];
+      if (i->resource != NULL || !tensor_quantization_supported(i))
+         return false;
+      if (i->scale != o->scale || i->zero_point != o->zero_point ||
+          i->is_signed != o->is_signed)
+         return false;
+      if (i->dims[0] != 1 || i->dims[1] != o->dims[1] ||
+          i->dims[2] != o->dims[2] || i->dims[3] <= 4)
+         return false;
+      if (k + 1 < operation->input_count && i->dims[3] % FEATURE_ATOMIC_SIZE)
+         return false;
+      for (unsigned j = 0; j < k; j++)
+         if (operation->input_tensors[j]->index == i->index)
+            return false;
+      c += i->dims[3];
+   }
+   return c == o->dims[3];
+}
