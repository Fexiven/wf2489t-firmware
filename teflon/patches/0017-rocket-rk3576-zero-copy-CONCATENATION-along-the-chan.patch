 }
 
+struct pipe_resource *
+rkt_resource_view(struct pipe_resource *parent, unsigned offset, unsigned size)
+{
+   struct rkt_resource *par = rkt_resource(parent);
+   struct rkt_resource *rsc;
+
+   /* a view of a view is a view of the BO */
+   if (par->parent) {
+      offset += par->view_offset;
+      parent = par->parent;
+      par = rkt_resource(parent);
+   }
+   rsc = rzalloc(NULL, struct rkt_resource);
+   if (!rsc)
+      return NULL;
+   assert(offset + size <= parent->width0);
+   rsc->base = *parent;
+   rsc->base.width0 = size;
+   pipe_reference_init(&rsc->base.reference, 1);
+   rsc->handle = par->handle;
+   rsc->phys_addr = par->phys_addr + offset;
+   rsc->fake_offset = par->fake_offset;
+   rsc->bo_size = size;
+   rsc->view_offset = offset;
+   pipe_resource_reference(&rsc->parent, parent);
+   return &rsc->base;
+}
