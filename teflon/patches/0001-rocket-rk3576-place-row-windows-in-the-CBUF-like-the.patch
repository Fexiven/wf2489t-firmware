--- a/src/gallium/drivers/rocket/rkt_ml.h
+++ b/src/gallium/drivers/rocket/rkt_ml.h
@@ -67,6 +67,19 @@ struct split_task {
     */
    unsigned staged_rows;
 
+   /*
+    * RK3576 CBUF placement as rknn-toolkit2 2.3.2 emits it (rkt_split_tasks_rk3576).
+    * The input part of the CBUF is a ring of data_banks * 1024 entries of 64 bytes.
+    * cbuf_wr is the entry this task's staged rows are written to (0x1040 low),
+    * cbuf_rd the entry of the first row its window reads (0x103c low), and
