+    */
+   bool rk3576_vendor;
+   bool data_reuse;
+   unsigned data_banks;
+   unsigned cbuf_wr;
+   unsigned cbuf_rd;
+
    unsigned output_width;
    unsigned output_height;
    unsigned output_channels;
