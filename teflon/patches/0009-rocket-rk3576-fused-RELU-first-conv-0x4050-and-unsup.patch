+                     poperation->conv.relu);
                   /*
                    * The offset takes the LIFT back out and knows nothing about
                    * the rounding term, which is the point: one is compensated
@@ -1234,8 +1235,9 @@ rkt_fill_biases(struct rkt_ml_subgraph *subgraph,
                 * agree, 128 is right and 0 reproduces today's floor; if they do
