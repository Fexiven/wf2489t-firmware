Subject: [PATCH] board: rockchip: add WF2489T wall tablet (RK3576S)

Wall tablet with the LAN MAC address in Rockchip vendor storage on the
eMMC; read it into ethaddr so it reaches the OS device tree.

---
diff --git a/arch/arm/mach-rockchip/rk3576/Kconfig b/arch/arm/mach-rockchip/rk3576/Kconfig
index f347caf8..5fca8d4f 100644
--- a/arch/arm/mach-rockchip/rk3576/Kconfig
+++ b/arch/arm/mach-rockchip/rk3576/Kconfig
@@ -6,6 +6,13 @@ config TARGET_ROC_PC_RK3576
 	  ROC-RK3576-PC is a single board computer from Firefly
 	  using the Rockchip RK3576.
 
+config TARGET_WF2489T_RK3576
+	bool "WF2489T wall tablet"
+	help
+	  The WF2489T is a 15.6" wall-mounted tablet (vendor board "R141 V10")
+	  with a Rockchip RK3576S: 1920x1080 eDP display, eMMC, Ethernet
+	  (RTL8168 on PCIe), Wi-Fi/BT and a Zigbee radio.
+
 config ROCKCHIP_BOOT_MODE_REG
 	default 0x26024040
 
@@ -15,6 +22,7 @@ config ROCKCHIP_STIMER_BASE
 config SYS_SOC
 	default "rk3576"
 
+source board/rockchip/wf2489t/Kconfig
 source board/firefly/roc-pc-rk3576/Kconfig
 
 config SYS_CONFIG_NAME
diff --git a/board/rockchip/wf2489t/Kconfig b/board/rockchip/wf2489t/Kconfig
new file mode 100644
index 00000000..81772eec
--- /dev/null
+++ b/board/rockchip/wf2489t/Kconfig
@@ -0,0 +1,9 @@
+if TARGET_WF2489T_RK3576
+
+config SYS_BOARD
+	default "wf2489t"
+
+config SYS_VENDOR
+	default "rockchip"
+
+endif
diff --git a/board/rockchip/wf2489t/MAINTAINERS b/board/rockchip/wf2489t/MAINTAINERS
new file mode 100644
index 00000000..109a95fd
--- /dev/null
+++ b/board/rockchip/wf2489t/MAINTAINERS
@@ -0,0 +1,6 @@
+WF2489T-RK3576
+M:	Fexiven <48439988+Fexiven@users.noreply.github.com>
+S:	Maintained
+F:	board/rockchip/wf2489t/
+F:	configs/wf2489t-rk3576_defconfig
+F:	arch/arm/dts/rk3576s-wf2489t*
diff --git a/board/rockchip/wf2489t/Makefile b/board/rockchip/wf2489t/Makefile
new file mode 100644
index 00000000..20b8f8d3
--- /dev/null
+++ b/board/rockchip/wf2489t/Makefile
@@ -0,0 +1,3 @@
