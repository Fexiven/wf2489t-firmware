+
+obj-y += wf2489t.o
diff --git a/board/rockchip/wf2489t/wf2489t.c b/board/rockchip/wf2489t/wf2489t.c
new file mode 100644
index 00000000..eae7191d
--- /dev/null
+++ b/board/rockchip/wf2489t/wf2489t.c
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * WF2489T: 15.6" wall tablet with a Rockchip RK3576S (vendor board "R141 V10")
+ *
+ * The LAN MAC address is stored per device in Rockchip "vendor storage" on
+ * the eMMC. It is put into "ethaddr", from where fdt_fixup_ethernet() passes
+ * it to the OS device tree (alias ethernet0, the RTL8168 on PCIe).
+ */
+
+#include <env.h>
+#include <log.h>
+#include <malloc.h>
+#include <mmc.h>
+#include <net-common.h>
+#include <linux/sizes.h>
+#include <linux/types.h>
+#include <asm/unaligned.h>
+
+/*
+ * Vendor storage: 4 copies of 64 KiB from eMMC sector 7168, outside any
+ * partition. Each copy: header, item table, item data from byte 1024, and
+ * the version repeated in its last 4 bytes (a copy is valid only if both
+ * match). The valid copy with the highest version is current.
+ */
+#define VENDOR_SECTOR		7168
+#define VENDOR_COPIES		4
+#define VENDOR_COPY_SIZE	SZ_64K
+#define VENDOR_TAG		0x524b5644	/* "VDKR" */
+#define VENDOR_DATA_OFFSET	1024
+#define VENDOR_ID_LAN_MAC	3
+
+struct vendor_hdr {
+	__le32 tag;
+	__le32 version;
+	__le16 next_index;
+	__le16 item_num;
+	__le16 free_offset;
+	__le16 free_size;
+} __packed;
+
+struct vendor_item {
+	__le16 id;
+	__le16 offset;
+	__le16 size;
+	__le16 flag;
+} __packed;
+
+static const u8 *vendor_current_copy(const u8 *buf)
+{
+	const u8 *best = NULL;
+	u32 best_version = 0;
+	int i;
+
+	for (i = 0; i < VENDOR_COPIES; i++) {
+		const u8 *copy = buf + i * VENDOR_COPY_SIZE;
+		const struct vendor_hdr *hdr = (const void *)copy;
+		u32 version = le32_to_cpu(hdr->version);
+		u32 version2 = get_unaligned_le32(copy + VENDOR_COPY_SIZE - 4);
+
+		if (le32_to_cpu(hdr->tag) != VENDOR_TAG || version != version2)
+			continue;
+		if (!best || version > best_version) {
+			best = copy;
+			best_version = version;
+		}
+	}
+
+	return best;
+}
+
+static int vendor_read(u16 id, void *data, size_t len)
+{
+	const size_t table_max = (VENDOR_DATA_OFFSET - sizeof(struct vendor_hdr)) /
+				 sizeof(struct vendor_item);
+	const size_t sectors = VENDOR_COPIES * VENDOR_COPY_SIZE / 512;
+	const struct vendor_item *item;
+	const struct vendor_hdr *hdr;
+	struct blk_desc *desc;
+	struct mmc *mmc;
+	const u8 *copy;
+	int i, n, ret = -ENOENT;
+	u8 *buf;
+
+	mmc = find_mmc_device(0);
+	if (!mmc || mmc_init(mmc))
+		return -ENODEV;
+	desc = mmc_get_blk_desc(mmc);
+	if (!desc)
+		return -ENODEV;
+
+	buf = malloc(VENDOR_COPIES * VENDOR_COPY_SIZE);
+	if (!buf)
+		return -ENOMEM;
+	if (blk_dread(desc, VENDOR_SECTOR, sectors, buf) != sectors) {
+		ret = -EIO;
+		goto out;
+	}
+
+	copy = vendor_current_copy(buf);
+	if (!copy)
+		goto out;
+
+	hdr = (const void *)copy;
+	item = (const void *)(copy + sizeof(*hdr));
+	n = min_t(size_t, le16_to_cpu(hdr->item_num), table_max);
+	for (i = 0; i < n; i++, item++) {
+		size_t offset = VENDOR_DATA_OFFSET + le16_to_cpu(item->offset);
+
+		if (le16_to_cpu(item->id) != id)
+			continue;
+		if (le16_to_cpu(item->size) < len ||
+		    offset + len > VENDOR_COPY_SIZE - 4) {
+			ret = -EINVAL;
+			break;
+		}
+		memcpy(data, copy + offset, len);
+		ret = 0;
+		break;
+	}
+
+out:
+	free(buf);
+	return ret;
+}
+
+/* runs before rockchip_setup_macaddr(), which then keeps this address */
+int rockchip_early_misc_init_r(void)
+{
+	u8 mac[ARP_HLEN];
+	int ret;
+
+	if (env_get("ethaddr"))
+		return 0;
+
+	ret = vendor_read(VENDOR_ID_LAN_MAC, mac, sizeof(mac));
+	if (ret || !is_valid_ethaddr(mac)) {
+		log_warning("No LAN MAC address in vendor storage (%d)\n", ret);
+		return 0;
+	}
+
+	return eth_env_set_enetaddr("ethaddr", mac);
+}
