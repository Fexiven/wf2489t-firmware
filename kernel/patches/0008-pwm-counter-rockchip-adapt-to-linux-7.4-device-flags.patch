Subject: [PATCH] pwm: rockchip-v4, counter: rockchip-pwm-capture: adapt to Linux 7.4

Linux 7.4 replaced struct device's of_node_reused field by a device flag
with accessors; use dev_set_of_node_reused().

---
--- a/drivers/pwm/pwm-rockchip-v4.c
+++ b/drivers/pwm/pwm-rockchip-v4.c
@@ -306,7 +306,7 @@
 	 * For referencing the PWM in the DT to work, we need the parent MFD
 	 * device's OF node.
 	 */
-	dev->of_node_reused = true;
+	dev_set_of_node_reused(dev);
 	device_set_node(dev, of_fwnode_handle(dev->parent->of_node));
 
 	chip = devm_pwmchip_alloc(dev, 1, sizeof(*pc));
--- a/drivers/counter/rockchip-pwm-capture.c
+++ b/drivers/counter/rockchip-pwm-capture.c
@@ -247,7 +247,7 @@
 	int ret;
 
 	/* Set our (still unset) OF node to the parent MFD device's OF node */
-	pdev->dev.parent->of_node_reused = true;
+	dev_set_of_node_reused(pdev->dev.parent);
 	device_set_node(&pdev->dev,
 			of_fwnode_handle(no_free_ptr(pdev->dev.parent->of_node)));
 
