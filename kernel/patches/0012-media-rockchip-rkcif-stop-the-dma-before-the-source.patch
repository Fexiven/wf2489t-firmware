media: rockchip: rkcif: stop the DMA before the source

Stopping the source first means no frame end interrupt comes any more,
so the wait always ran into its 1 s timeout, and the CSI-2 receiver gated
its clocks under the still running DMA. On the RK3576 that hangs the bus
now and then. Wait for the frame end while the source still sends (at
most one frame), then stop the source.

diff --git a/drivers/media/platform/rockchip/rkcif/rkcif-stream.c b/drivers/media/platform/rockchip/rkcif/rkcif-stream.c
index 3130d420a..f65529c99 100644
--- a/drivers/media/platform/rockchip/rkcif/rkcif-stream.c
+++ b/drivers/media/platform/rockchip/rkcif/rkcif-stream.c
@@ -308,10 +308,12 @@ static void rkcif_stream_stop_streaming(struct vb2_queue *queue)
 	u64 mask;
 	int ret;
 
-	mask = BIT_ULL(stream->id);
-	v4l2_subdev_disable_streams(&stream->interface->sd, RKCIF_IF_PAD_SRC,
-				    mask);
-
+	/*
+	 * Stop the DMA at the next frame end while the source still sends,
+	 * then the source. With the source stopped first no frame end comes,
+	 * and the CSI-2 receiver gates its clocks under the running DMA,
+	 * which can hang the bus.
+	 */
 	stream->stopping = true;
 	ret = wait_event_timeout(stream->wq_stopped, !stream->stopping,
 				 msecs_to_jiffies(1000));
@@ -319,6 +321,10 @@ static void rkcif_stream_stop_streaming(struct vb2_queue *queue)
 	if (!ret && stream->stop_streaming)
 		stream->stop_streaming(stream);
 
+	mask = BIT_ULL(stream->id);
+	v4l2_subdev_disable_streams(&stream->interface->sd, RKCIF_IF_PAD_SRC,
+				    mask);
+
 	pm_runtime_put(rkcif->dev);
 
 	rkcif_stream_return_all_buffers(stream, VB2_BUF_STATE_ERROR);
