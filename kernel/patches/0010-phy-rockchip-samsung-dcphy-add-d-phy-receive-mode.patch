+static void samsung_mipi_dphy_rx_config(struct samsung_mipi_dcphy *samsung)
+{
+	/* LP-RX hysteresis, LP escape clock polarity and skew calibration fine delay */
+	static const u8 lp_hys_sw[4] = { 3, 0, 0, 0 };
+	static const u8 lp_escclk_pol[4] = { 1, 0, 0, 0 };
+	static const u8 skew_cal[4] = { 0, 3, 3, 3 };
+	const u32 hs_term = 2;	/* HS-RX termination impedance */
+	unsigned int mbps = samsung->rx_mbps;
+	u32 dlysel, settle;
+	int i;
+
+	if (mbps < 1500)
+		dlysel = 0;
+	else if (mbps < 2000)
+		dlysel = 3 << 8;
+	else if (mbps < 3000)
+		dlysel = 2 << 8;
+	else if (mbps < 4000)
+		dlysel = 1 << 8;
+	else
+		dlysel = 0;
+
+	for (i = 0; i < ARRAY_SIZE(samsung_mipi_dphy_rx_settle) - 1; i++)
+		if (samsung_mipi_dphy_rx_settle[i].mbps >= mbps)
+			break;
+	settle = samsung_mipi_dphy_rx_settle[i].settle;
+
+	regmap_write(samsung->regmap, RX_CLK_LANE(RX_GNR_CON1), 0x1450);
+	regmap_write(samsung->regmap, RX_CLK_LANE(RX_ANA_CON1), 0x8000);
+	regmap_write(samsung->regmap, RX_CLK_LANE(RX_ANA_CON2), hs_term);
+	regmap_write(samsung->regmap, RX_CLK_LANE(RX_ANA_CON3), 0x0600);
+	regmap_write(samsung->regmap, RX_CLK_LANE(RX_THS_SETTLE), 0x301);
+
+	for (i = 0; i < samsung->lanes; i++) {
+		regmap_write(samsung->regmap, RX_DATA_LANE(i, RX_GNR_CON1), 0x1450);
+		regmap_write(samsung->regmap, RX_DATA_LANE(i, RX_ANA_CON1), 0x8000);
+		regmap_write(samsung->regmap, RX_DATA_LANE(i, RX_ANA_CON2), dlysel | hs_term);
+		regmap_write(samsung->regmap, RX_DATA_LANE(i, RX_ANA_CON3),
+			     0x0600 | lp_hys_sw[i] << 4 | lp_escclk_pol[i] << 11);
+		if (i < 3)	/* lane 3 is not a combo lane */
+			regmap_write(samsung->regmap, RX_DATA_LANE(i, RX_ANA_CON7), 0x40);
+		regmap_write(samsung->regmap, RX_DATA_LANE(i, RX_DESKEW_CON2), skew_cal[i]);
+		if (mbps >= 1500) {
+			regmap_write(samsung->regmap, RX_DATA_LANE(i, RX_DESKEW_CON0), BIT(0));
+			regmap_write(samsung->regmap, RX_DATA_LANE(i, RX_DESKEW_CON4), 0x81a);
+		}
+		regmap_update_bits(samsung->regmap, RX_DATA_LANE(i, RX_THS_SETTLE), 0x1ff, settle);
+		regmap_update_bits(samsung->regmap, RX_DATA_LANE(i, RX_ERR_SOT_SYNC), 0xff, 0x03);
+	}
+}
+
+static int samsung_mipi_dphy_rx_power_on(struct samsung_mipi_dcphy *samsung)
+{
+	u32 sts;
+	int i;
+
+	reset_control_assert(samsung->s_phy_rst);
+
+	samsung_mipi_dcphy_bias_block_enable(samsung);
+	samsung_mipi_dphy_rx_config(samsung);
+
+	regmap_update_bits(samsung->regmap, RX_CLK_LANE(RX_ENABLE), PHY_ENABLE, PHY_ENABLE);
+	for (i = 0; i < samsung->lanes; i++)
+		regmap_update_bits(samsung->regmap, RX_DATA_LANE(i, RX_ENABLE),
+				   PHY_ENABLE, PHY_ENABLE);
+
+	/* the lanes only get ready once the transmitter drives them */
+	if (regmap_read_poll_timeout(samsung->regmap, RX_CLK_LANE(RX_ENABLE),
+				     sts, sts & PHY_READY, 200, 4000))
+		dev_dbg(samsung->dev, "rx clock lane not ready yet\n");
+	for (i = 0; i < samsung->lanes; i++)
+		if (regmap_read_poll_timeout(samsung->regmap, RX_DATA_LANE(i, RX_ENABLE),
+					     sts, sts & PHY_READY, 200, 2000))
+			dev_dbg(samsung->dev, "rx data lane %d not ready yet\n", i);
+
+	reset_control_deassert(samsung->s_phy_rst);
+
+	return 0;
+}
+
+static void samsung_mipi_dphy_rx_power_off(struct samsung_mipi_dcphy *samsung)
+{
+	int i;
+
+	reset_control_assert(samsung->s_phy_rst);
+	regmap_update_bits(samsung->regmap, RX_CLK_LANE(RX_ENABLE), PHY_ENABLE, 0);
+	for (i = 0; i < samsung->lanes; i++)
+		regmap_update_bits(samsung->regmap, RX_DATA_LANE(i, RX_ENABLE), PHY_ENABLE, 0);
+	reset_control_deassert(samsung->s_phy_rst);
+}
+
 static int samsung_mipi_dcphy_power_on(struct phy *phy)
 {
