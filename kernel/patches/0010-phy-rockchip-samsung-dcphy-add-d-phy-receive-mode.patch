 		return samsung_mipi_dphy_power_on(samsung);
 	default:
 		/* CPHY part to be implemented later */
@@ -1383,6 +1522,10 @@ static int samsung_mipi_dcphy_power_off(struct phy *phy)
 
 	switch (samsung->type) {
 	case PHY_TYPE_DPHY:
+		if (samsung->rx) {
