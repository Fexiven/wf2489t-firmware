 	default:
@@ -1490,12 +1633,29 @@ static int samsung_mipi_dcphy_configure(struct phy *phy,
 
 	samsung->lanes = opts->mipi_dphy.lanes > 4 ? 4 : opts->mipi_dphy.lanes;
 
