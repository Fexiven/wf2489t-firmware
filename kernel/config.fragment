# WF2489T additions to the arm64 defconfig (mainline)
CONFIG_ARCH_ROCKCHIP=y
# display: VOP2 -> eDP -> panel, backlight on/off via GPIO for now
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_ANALOGIX_DP=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX=y
CONFIG_DRM_PANEL_EDP=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y
CONFIG_DRM_PANFROST=y
# storage, PMIC, Ethernet
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_PCIE_ROCKCHIP_DW_HOST=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_R8169=y
# board devices
CONFIG_KEYBOARD_ADC=y
CONFIG_LEDS_GPIO=y
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_SENSORS_SHT3x=y
CONFIG_STK3310=y
CONFIG_KXCJK1013=y
CONFIG_RTC_DRV_HYM8563=y
CONFIG_DW_WATCHDOG=y
CONFIG_EXT4_FS=y
# serial: ttyS0..ttyS9 so the DT aliases keep the stock numbering (Zigbee = ttyS6)
CONFIG_SERIAL_8250_NR_UARTS=10
CONFIG_SERIAL_8250_RUNTIME_UARTS=10
