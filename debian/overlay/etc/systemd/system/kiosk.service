[Unit]
Description=Kiosk browser (cage + cog) on the display
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
UtmpIdentifier=tty1
UtmpMode=user
StandardInput=tty-fail
TTYReset=yes
TTYVHangup=yes
EnvironmentFile=/etc/default/kiosk
ExecStart=/usr/bin/cage -s -- /usr/bin/cog $KIOSK_COG_OPTIONS ${KIOSK_URL}
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
